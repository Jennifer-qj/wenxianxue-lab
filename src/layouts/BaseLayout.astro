---
import "../styles/global.css";
import WelcomeGuide from "../components/WelcomeGuide";

interface Props {
  title?: string;
  description?: string;
  active?: "home" | "paths" | "graph" | "lab" | "progress" | "search" | "guide" | "about";
}

const {
  title = "文献学实验室",
  description = "一个面向初学者的文献学互动学习与数字人文项目",
  active = "home",
} = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const nav = [
  ["home", "首页", base],
  ["paths", "学习路径", `${base}paths/`],
  ["graph", "知识图谱", `${base}graph/`],
  ["lab", "互动实验室", `${base}lab/`],
  ["progress", "学习进度", `${base}progress/`],
];
const fullTitle = title === "文献学实验室" ? title : `${title}｜文献学实验室`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const ogImage = new URL(`${base}og-cover.svg`, Astro.site ?? Astro.url.origin);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1eadc" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="文献学实验室" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <a class="brand" href={base} aria-label="文献学实验室首页">
        <span class="brand-mark" aria-hidden="true">文</span>
        <span>
          <strong>文献学实验室</strong>
          <small>WENXIANXUE LAB</small>
        </span>
      </a>
      <nav aria-label="主导航">
        {nav.map(([id, label, href]) => (
          <a href={href} aria-current={active === id ? "page" : undefined}>{label}</a>
        ))}
      </nav>
      <div class="header-tools">
        <a href={`${base}guide/`} aria-current={active === "guide" ? "page" : undefined}>指南</a>
        <a href={`${base}search/`} aria-current={active === "search" ? "page" : undefined}>搜索</a>
        <a href={`${base}about/`} aria-current={active === "about" ? "page" : undefined}>项目</a>
        <a class="github-link" href="https://github.com/Jennifer-qj/wenxianxue-lab" target="_blank" rel="noreferrer">GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>文献学实验室</strong>
        <p>边读、边辨、边连接。让文献学成为可以操作的知识。</p>
      </div>
      <div class="footer-meta">
        <span>个人学习与数字人文实践</span>
        <span>参考杜泽逊《文献学概要（修订本）》</span>
        <span>不提供原书全文</span>
        <a href={`${base}about/`}>方法、版权与引用说明 →</a>
        <a href={`${base}guide/`}>网站使用指南 →</a>
        <a href={`${base}updates/`}>更新日志、路线图与开放数据 →</a>
      </div>
    </footer>
    <WelcomeGuide baseUrl={base} client:load />
  </body>
</html>

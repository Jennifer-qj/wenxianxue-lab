---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  active?: "home" | "paths" | "graph" | "lab" | "progress";
}

const {
  title = "文献学实验室",
  description = "一个面向初学者的文献学互动学习与数字人文项目",
  active = "home",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const nav = [
  ["home", "首页", base],
  ["paths", "学习路径", `${base}paths/`],
  ["graph", "知识图谱", `${base}graph/`],
  ["lab", "互动实验室", `${base}lab/`],
  ["progress", "学习进度", `${base}progress/`],
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1eadc" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title>{title === "文献学实验室" ? title : `${title}｜文献学实验室`}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <header class="site-header">
      <a class="brand" href={base} aria-label="文献学实验室首页">
        <span class="brand-mark" aria-hidden="true">文</span>
        <span>
          <strong>文献学实验室</strong>
          <small>WENXIANXUE LAB</small>
        </span>
      </a>
      <nav aria-label="主导航">
        {nav.map(([id, label, href]) => (
          <a href={href} aria-current={active === id ? "page" : undefined}>{label}</a>
        ))}
      </nav>
      <a class="github-link" href="https://github.com/Jennifer-qj/wenxianxue-lab" target="_blank" rel="noreferrer">
        GitHub <span aria-hidden="true">↗</span>
      </a>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <strong>文献学实验室</strong>
        <p>边读、边辨、边连接。让文献学成为可以操作的知识。</p>
      </div>
      <div class="footer-meta">
        <span>个人学习与数字人文实践</span>
        <span>参考杜泽逊《文献学概要（修订本）》</span>
        <span>不提供原书全文</span>
      </div>
    </footer>
  </body>
</html>

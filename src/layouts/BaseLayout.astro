---
import "../styles/global.css";
import WelcomeGuide from "../components/WelcomeGuide";
import LearningDock from "../components/LearningDock";
import FeedbackPanel from "../components/FeedbackPanel";
import type { LibraryPageType } from "../lib/learningArchive";
import { PROJECT_RELEASE } from "../consts";

interface Props {
  title?: string;
  description?: string;
  active?: "home" | "paths" | "graph" | "lab" | "progress" | "search" | "guide" | "about" | "notebook";
}

const {
  title = "文献学实验室",
  description = "一个面向初学者的文献学互动学习与数字人文项目",
  active = "home",
} = Astro.props;
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const nav = [
  ["home", "首页", base],
  ["paths", "学习路径", `${base}paths/`],
  ["graph", "知识图谱", `${base}graph/`],
  ["lab", "互动实验室", `${base}lab/`],
  ["progress", "学习进度", `${base}progress/`],
];
const fullTitle = title === "文献学实验室" ? title : `${title}｜文献学实验室`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const pageType: LibraryPageType = Astro.url.pathname.includes("/chapters/") ? "chapter"
  : Astro.url.pathname.includes("/concepts/") ? "concept"
  : Astro.url.pathname.includes("/lab/") ? "lab"
  : Astro.url.pathname.includes("/paths/") ? "path"
  : Astro.url.pathname.includes("/guide/") ? "guide" : "other";
const ogImage = new URL(`${base}og-cover.png`, Astro.site ?? Astro.url.origin);
const structuredData = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  name: fullTitle,
  description,
  url: canonical,
  image: ogImage,
  inLanguage: "zh-CN",
  isAccessibleForFree: true,
  educationalLevel: "大学初学者",
  learningResourceType: ["互动学习网站", "数字人文项目", "知识图谱"],
  about: ["文献学", "古典文献学", "目录学", "版本学", "校勘学", "数字人文"],
  author: { "@type": "Person", name: "Jennifer-qj" },
  citation: "杜泽逊：《文献学概要（修订本）》",
};
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1eadc" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="manifest" href={`${base}site.webmanifest`} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="文献学实验室" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="文献学实验室：边读、边辨、边连接" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <div class="reading-progress" aria-hidden="true"><span></span></div>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href={base} aria-label="文献学实验室首页">
          <span class="brand-mark" aria-hidden="true">文</span>
          <span>
            <strong>文献学实验室</strong>
            <small>WENXIANXUE LAB</small>
          </span>
        </a>
        <nav class="primary-nav" aria-label="主导航">
          {nav.map(([id, label, href]) => (
            <a href={href} aria-current={active === id ? "page" : undefined}>{label}</a>
          ))}
        </nav>
        <div class="header-tools">
          <a class="search-link" href={`${base}search/`} aria-current={active === "search" ? "page" : undefined} aria-label="搜索全站"><span aria-hidden="true">⌕</span><b>搜索</b></a>
          <details class="more-menu">
            <summary>更多 <span aria-hidden="true">⌄</span></summary>
            <div>
              <a href={`${base}notebook/`} aria-current={active === "notebook" ? "page" : undefined}><span>札记</span><small>收藏、批注与最近浏览</small></a>
              <a href={`${base}guide/`} aria-current={active === "guide" ? "page" : undefined}><span>使用指南</span><small>第一次来，从这里开始</small></a>
              <a href={`${base}about/`} aria-current={active === "about" ? "page" : undefined}><span>关于项目</span><small>方法、版权与作者说明</small></a>
              <a href={`${base}showcase/`}><span>项目展示</span><small>三分钟演示与成果证据</small></a>
              <a href={`${base}contribute/`}><span>参与共校</span><small>纠错、认领与功能建议</small></a>
              <a href={`${base}usability/`}><span>参与用户测试</span><small>用六个任务检验网站体验</small></a>
              <a href={`${base}accessibility/`}><span>无障碍说明</span><small>键盘、小屏与阅读辅助</small></a>
              <a class="github-link" href="https://github.com/Jennifer-qj/wenxianxue-lab" target="_blank" rel="noreferrer"><span>GitHub ↗</span><small>查看代码与更新记录</small></a>
            </div>
          </details>
        </div>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer container">
      <div class="footer-intro">
        <span class="footer-seal" aria-hidden="true">文</span>
        <div>
        <strong>文献学实验室</strong>
        <p>边读、边辨、边连接。让文献学成为可以操作的知识。</p>
        </div>
      </div>
      <nav class="footer-links" aria-label="页脚导航">
        <a href={`${base}story/`}>作者手记</a>
        <a href={`${base}about/`}>方法与版权</a>
        <a href={`${base}guide/`}>使用指南</a>
        <a href={`${base}updates/`}>更新日志</a>
        <a href={`${base}audit/`}>内容审计</a>
        <a href={`${base}showcase/`}>项目展示</a>
        <a href={`${base}contribute/`}>参与共校</a>
        <a href={`${base}usability/`}>用户测试</a>
        <a href={`${base}accessibility/`}>无障碍说明</a>
      </nav>
      <div class="footer-meta">
        <a class="release-stamp" href={`${base}updates/`} aria-label={`查看 ${PROJECT_RELEASE.label} ${PROJECT_RELEASE.version} 的更新记录`}>
          <b>{PROJECT_RELEASE.label} v{PROJECT_RELEASE.version}</b>
          <time datetime={PROJECT_RELEASE.updated}>更新于 {PROJECT_RELEASE.updated}</time>
        </a>
        <span>个人学习与数字人文实践</span>
        <span>参考杜泽逊《文献学概要（修订本）》</span>
        <span>© 2026 Jennifer-qj · 不提供原书全文</span>
      </div>
    </footer>
    <WelcomeGuide baseUrl={base} client:load />
    {active !== "notebook" && <LearningDock baseUrl={base} title={title} pageType={pageType} client:load />}
    <FeedbackPanel baseUrl={base} title={title} client:load />
    <script is:inline>
      const progressBar = document.querySelector('.reading-progress span');
      const updateReadingProgress = () => {
        const distance = document.documentElement.scrollHeight - window.innerHeight;
        const value = distance > 0 ? Math.min(1, Math.max(0, window.scrollY / distance)) : 0;
        if (progressBar) progressBar.style.transform = `scaleX(${value})`;
      };
      updateReadingProgress();
      window.addEventListener('scroll', updateReadingProgress, { passive: true });
      document.addEventListener('click', (event) => {
        document.querySelectorAll('.more-menu[open]').forEach((menu) => {
          if (!menu.contains(event.target)) menu.removeAttribute('open');
        });
      });
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (!reduceMotion && 'IntersectionObserver' in window) {
        const revealTargets = [...document.querySelectorAll('main > section:not(:first-child), main > div > section, .section-heading')];
        document.documentElement.classList.add('reveal-enabled');
        revealTargets.forEach((item, index) => {
          item.setAttribute('data-reveal', '');
          item.style.setProperty('--reveal-delay', `${Math.min(index % 4, 3) * 45}ms`);
        });
        const revealObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add('is-visible');
            revealObserver.unobserve(entry.target);
          });
        }, { rootMargin: '0px 0px -7% 0px', threshold: 0.06 });
        revealTargets.forEach((item) => revealObserver.observe(item));
      }
    </script>
  </body>
</html>

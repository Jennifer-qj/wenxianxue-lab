---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ChapterCheck from "../../components/ChapterCheck";
import ResearchQuestionWorkbench from "../../components/ResearchQuestionWorkbench";
import StructuredPractice from "../../components/StructuredPractice";
import DeepDiveStudio from "../../components/DeepDiveStudio";
import ChapterSignature from "../../components/ChapterSignature.astro";
import { chapters, learningPaths } from "../../data/site";
import { getLesson, lessons } from "../../data/lessons";
import { EDITION } from "../../consts";
import { getCollection } from "astro:content";

export function getStaticPaths() {
  return lessons.map((lesson) => ({ params: { id: lesson.chapterId } }));
}

const chapterId = Astro.params.id!;
const chapter = chapters.find((item) => item.id === chapterId)!;
const lesson = getLesson(chapterId)!;
const chapterIndex = chapters.findIndex((item) => item.id === chapterId);
const previous = chapters[chapterIndex - 1];
const next = chapters[chapterIndex + 1];
const path = learningPaths.find((item) => chapter.pathIds.includes(item.id));
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const outlineEntries = await getCollection("outline");
const conceptEntries = await getCollection("concepts");
const quizEntries = await getCollection("quiz");
const deepDiveEntries = await getCollection("deepdives");
const chapterUnits = outlineEntries.flatMap((entry) => entry.data.items).filter((unit) => unit.chapter === chapterIndex + 1);
const structuredConcepts = conceptEntries.flatMap((entry) => entry.data.items).filter((concept) => concept.chapter_ids.includes(chapterId));
const structuredQuizzes = quizEntries.flatMap((entry) => entry.data.items).filter((quiz) => quiz.chapter === chapterIndex + 1);
const deepDive = deepDiveEntries.flatMap((entry) => entry.data.items).find((study) => study.chapter === chapterIndex + 1);
const statusLabels = { not_started: "未开始", drafting: "整理中", pending_review: "待复核", reviewed: "已复核", verified: "已核验" } as const;
---

<BaseLayout title={`${chapter.number} ${chapter.title}`} active="paths">
  <header class="chapter-hero">
    <div class="container">
      <div class="crumbs"><a href={`${base}paths/`}>学习路径</a><span>／</span><a href={`${base}paths/${path?.id}/`}>{path?.title}</a><span>／</span><b>{chapter.number}</b></div>
      <div class="hero-grid">
        <div>
          <p class="eyebrow">{chapter.number} · Chapter {String(chapterIndex + 1).padStart(2, "0")}</p>
          <h1>{chapter.title}</h1>
          <p class="guiding">{lesson.guidingQuestion}</p>
        </div>
        <aside>
          <span>{chapter.review}</span>
          <dl>
            <div><dt>学习单元</dt><dd>{chapterUnits.length || chapter.sections.length}</dd></div>
            <div><dt>核心概念</dt><dd>{structuredConcepts.length || lesson.concepts.length}</dd></div>
            <div><dt>结构化题目</dt><dd>{structuredQuizzes.length || lesson.quiz.length}</dd></div>
          </dl>
        </aside>
      </div>
    </div>
  </header>

  <div class="chapter-layout container">
    <aside class="toc">
      <small>本章导航</small>
      <a href="#overview">导读</a>
      {["ch01", "ch05", "ch07"].includes(chapterId) && <a href="#signature">本章专属入口</a>}
      {chapterUnits.length > 0 && <a href="#learning-units">结构化学习单元</a>}
      {deepDive && <a href="#deep-dive">案例研读工作台</a>}
      {chapterId === "ch01" && <a href="#workbench">研究问题装配台</a>}
      {lesson.concepts.map((concept, index) => <a href={`#concept-${index + 1}`}>{String(index + 1).padStart(2, "0")} {concept.title}</a>)}
      <a href="#workflow">方法步骤</a>
      <a href="#check">本章检测</a>
      <a href="#source">来源说明</a>
    </aside>

    <article class="lesson">
      <section id="overview" class="overview">
        <p class="eyebrow">本章导读</p>
        <p>{lesson.introduction}</p>
        <div class="provenance" aria-label="本章内容身份说明">
          <div><small>知识框架</small><strong>依据原书章节目录定位</strong></div>
          <div><small>页面文字</small><strong>项目原创转述与教学改编</strong></div>
          <div><small>制作方式</small><strong>人机协作草拟，人工持续复核</strong></div>
          <div><small>引用边界</small><strong>不是原书逐字引文</strong></div>
        </div>
        <div class="section-map">
          {chapter.sections.map((section, index) => <span><b>{index + 1}</b>{section}</span>)}
        </div>
      </section>

      {["ch01", "ch05", "ch07"].includes(chapterId) && <ChapterSignature chapterId={chapterId} baseUrl={base} />}

      {chapterUnits.length > 0 && (
        <section id="learning-units" class="learning-units">
          <div class="unit-intro">
            <div>
              <p class="eyebrow">第 {chapterIndex + 1} 章结构化内容</p>
              <h2>{chapterUnits.length} 个正式学习单元</h2>
            </div>
            <p>依据中华书局 2008 年修订本目录锚点拆分，已经关联概念、题目与实验。只有完成纸本逐条核验的单元才公开页码，其余内容明确标记为待复核。</p>
          </div>
          <div class="unit-list">
            {chapterUnits.map((unit, index) => (
              <article id={unit.id}>
                <div class="unit-meta"><span>{String(index + 1).padStart(2, "0")}</span><small>{statusLabels[unit.status]}</small><b>{unit.status === "verified" ? `第 ${unit.page_start}${unit.page_end && unit.page_end !== unit.page_start ? `—${unit.page_end}` : ""} 页` : "页码待纸本核验"}</b></div>
                <div>
                  <h3>{unit.subsection ?? unit.section}</h3>
                  <p class="unit-question">{unit.key_question}</p>
                  <dl>
                    <div><dt>学习结论</dt><dd>{unit.summary}</dd></div>
                    <div><dt>判断边界</dt><dd>{unit.boundary}</dd></div>
                  </dl>
                  <div class="unit-tags"><span>原书目录锚点</span><span>项目原创概括</span><span>{statusLabels[unit.status]}</span><span>{unit.concept_ids.length} 个概念</span><span>{unit.quiz_ids.length} 道题</span><span>{unit.lab_ids.length} 个实验</span></div>
                  <div class="unit-concepts">{unit.concept_ids.map((id) => { const item = structuredConcepts.find((concept) => concept.id === id) ?? conceptEntries.flatMap((entry) => entry.data.items).find((concept) => concept.id === id); return <a href={`${base}concepts/${id}/`}>{item?.label ?? id}</a>; })}</div>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      {chapterId === "ch01" && (
        <section id="workbench" class="workbench-section">
          <p class="eyebrow">从“记定义”到“造问题”</p>
          <h2>先学会提出文献学问题</h2>
          <p class="workbench-lead">同一部材料可以被多个研究镜头观察。组合镜头、控制表述强度，比猜中一个标准答案更接近真实研究。</p>
          <ResearchQuestionWorkbench client:load />
        </section>
      )}

      {deepDive && (
        <section id="deep-dive" class="deep-dive-section">
          <div class="deep-dive-heading">
            <p class="eyebrow">第二层：证据型研读</p>
            <h2>把本章知识用于一个具体问题</h2>
            <p>以下内容属于项目设计的教学情境，不冒充真实馆藏档案。选择材料、完成分析步骤，并形成一项可放入个人作品集的小成果；进度只保存在当前浏览器。</p>
          </div>
          <DeepDiveStudio study={deepDive} client:load />
        </section>
      )}

      {lesson.concepts.map((concept, index) => (
        <section id={`concept-${index + 1}`} class="concept">
          <div class="concept-heading"><span>{String(index + 1).padStart(2, "0")}</span><h2>{concept.title}</h2></div>
          <div class="content-identity"><span>项目教学释义</span><span>人机协作草拟</span><span>不作为原书引文</span></div>
          <p>{concept.explanation}</p>
          <div class="evidence-pair">
            <div><small>例子</small><p>{concept.example}</p></div>
            <div><small>判断边界</small><p>{concept.caution}</p></div>
          </div>
        </section>
      ))}

      <section id="workflow" class="workflow">
        <p class="eyebrow">把知识变成方法</p>
        <h2>处理这类材料时，可以怎样做？</h2>
        <ol>
          {lesson.workflow.map((step) => <li>{step}</li>)}
        </ol>
      </section>

      <section id="check" class="check">
        <p class="eyebrow">Quick check</p>
        <h2>本章检测</h2>
        <p>不是背定义，而是判断证据该如何使用。完成后会自动记入本机学习进度。</p>
        {structuredQuizzes.length > 0
          ? <StructuredPractice quizzes={structuredQuizzes} client:load />
          : <ChapterCheck chapterId={chapter.id} title={chapter.title} quiz={lesson.quiz} client:load />}
      </section>

      <section class="questions">
        <p class="eyebrow">带着问题继续读</p>
        {lesson.furtherQuestions.map((question) => <blockquote>{question}</blockquote>)}
      </section>

      <section id="source" class="source-note">
        <div>
          <p class="eyebrow">来源与版权</p>
          <h2>{EDITION.publisher} {EDITION.year} 年修订本</h2>
        </div>
        <p>本页为项目原创导读、教学释义与互动练习，不提供原书全文，也不将教学案例冒充真实馆藏材料。内容采用人机协作方式草拟，由项目作者承担纸本复核责任。当前状态为“{chapter.review}”；仅“已核验”学习单元公开纸本页码，正式论文请直接引用原书。</p>
      </section>
    </article>
  </div>

  <nav class="chapter-pagination container" aria-label="章节前后导航">
    {previous ? <a href={`${base}chapters/${previous.id}/`}><small>上一章</small><strong>{previous.title}</strong></a> : <span></span>}
    {next ? <a class="next" href={`${base}chapters/${next.id}/`}><small>下一章</small><strong>{next.title}</strong></a> : <a class="next" href={`${base}lab/`}><small>完成全书导读</small><strong>进入互动实验室</strong></a>}
  </nav>
  <script is:inline>
    const tocLinks = [...document.querySelectorAll('.toc a[href^="#"]')];
    const sections = tocLinks.map((link) => document.querySelector(link.getAttribute('href'))).filter(Boolean);
    if (sections.length && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver((entries) => {
        const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!visible) return;
        tocLinks.forEach((link) => link.removeAttribute('aria-current'));
        document.querySelector(`.toc a[href="#${visible.target.id}"]`)?.setAttribute('aria-current', 'location');
      }, { rootMargin: '-18% 0px -70% 0px', threshold: 0 });
      sections.forEach((section) => observer.observe(section));
    }
  </script>
</BaseLayout>

<style>
  .chapter-hero{padding:4rem 0 3rem;border-bottom:1px solid var(--line);background:linear-gradient(120deg,rgba(143,53,43,.09),transparent 55%)}.crumbs{display:flex;gap:.5rem;align-items:center;margin-bottom:3rem;color:var(--muted);font-size:.75rem}.crumbs a{text-decoration:none}.hero-grid{display:grid;grid-template-columns:1.4fr .6fr;gap:5rem;align-items:end}.chapter-hero h1{margin:.2rem 0;font-family:var(--serif);font-size:clamp(3rem,7vw,6rem)}.guiding{max-width:50rem;color:var(--cinnabar);font-family:var(--serif);font-size:1.2rem}.chapter-hero aside{padding:1.2rem;border:1px solid var(--line);background:rgba(255,253,247,.55)}.chapter-hero aside>span{padding:.15rem .5rem;border-radius:99px;color:#7a5b2d;background:#eee1c5;font-size:.68rem}.chapter-hero dl{display:grid;grid-template-columns:repeat(3,1fr);margin:1rem 0 0}.chapter-hero dl div{border-right:1px solid var(--line)}.chapter-hero dl div:last-child{border:0}.chapter-hero dt{color:var(--muted);font-size:.7rem}.chapter-hero dd{margin:0;font-family:var(--serif);font-size:1.4rem}
  .chapter-layout{display:grid;grid-template-columns:210px 1fr;gap:5rem;padding-top:4rem}.toc{position:sticky;top:100px;height:max-content;display:flex;flex-direction:column;border-top:1px solid var(--line)}.toc small{padding:.8rem 0;color:var(--muted)}.toc a{padding:.5rem 0;border-bottom:1px solid var(--line);color:var(--muted);font-size:.78rem;text-decoration:none}.toc a:hover{color:var(--cinnabar)}
  .lesson>section{scroll-margin-top:110px;padding:3rem 0;border-bottom:1px solid var(--line)}.overview>p:not(.eyebrow){font-family:var(--serif);font-size:1.15rem;line-height:2}.section-map{display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem;margin-top:2rem}.section-map span{display:flex;align-items:center;gap:.7rem;padding:.7rem;border:1px solid var(--line);font-size:.8rem}.section-map b{color:var(--cinnabar);font-family:var(--serif)}
  .concept-heading{display:flex;align-items:center;gap:1rem}.concept-heading>span{color:var(--cinnabar);font-family:var(--serif);font-size:1.6rem}.concept h2,.workflow h2,.check h2,.source-note h2{margin:0;font-family:var(--serif);font-size:2rem}.concept>p{font-family:var(--serif);font-size:1.08rem;line-height:2}.evidence-pair{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.evidence-pair>div{padding:1rem;border-left:3px solid #a57435;background:rgba(255,255,255,.35)}.evidence-pair>div:last-child{border-color:var(--cinnabar)}.evidence-pair small{color:var(--muted);letter-spacing:.1em}.evidence-pair p{margin:.25rem 0;color:var(--muted);font-size:.86rem}
  .provenance{display:grid;grid-template-columns:repeat(4,1fr);margin:2rem 0;border-top:1px solid var(--line);border-left:1px solid var(--line)}.provenance>div{padding:.85rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:#fffaf0}.provenance small,.provenance strong{display:block}.provenance small{margin-bottom:.35rem;color:var(--cinnabar);font-size:.65rem}.provenance strong{font-family:var(--serif);font-size:.82rem;line-height:1.55}.content-identity{display:flex;flex-wrap:wrap;gap:.35rem;margin:.7rem 0 1.4rem}.content-identity span{padding:.22rem .45rem;border:1px solid var(--line);color:var(--muted);background:#fffaf0;font-size:.64rem}
  .unit-concepts{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.65rem}.unit-concepts a{padding:.2rem .45rem;border:1px solid var(--line);color:var(--cinnabar);background:#fffaf0;font-size:.68rem;text-decoration:none}.unit-concepts a:hover{color:white;background:var(--cinnabar)}
  .workflow ol{display:grid;grid-template-columns:repeat(3,1fr);gap:.7rem;counter-reset:method;padding:0;list-style:none}.workflow li{min-height:100px;padding:1rem;border:1px solid var(--line);background:rgba(255,255,255,.3)}.workflow li::before{counter-increment:method;content:counter(method);display:block;color:var(--cinnabar);font-family:var(--serif);font-size:1.5rem}.check>p:not(.eyebrow){color:var(--muted)}
  :global(.check-question){display:grid;grid-template-columns:45px 1fr;gap:1rem;padding:1.5rem 0;border-top:1px solid var(--line)}:global(.check-number){color:var(--cinnabar);font-family:var(--serif);font-size:1.4rem}:global(.check-question h3){margin:0 0 .8rem;font-family:var(--serif)}:global(.check-options){display:grid;grid-template-columns:1fr 1fr;gap:.5rem}:global(.check-options button){display:flex;gap:.5rem;padding:.65rem;text-align:left;border:1px solid var(--line);background:rgba(255,255,255,.35);font:inherit;cursor:pointer}:global(.check-options button span){color:var(--cinnabar);font-weight:700}:global(.check-options button.correct){border-color:#5c8066;background:#e3eee3}:global(.check-options button.incorrect){border-color:#9f584c;background:#f2dfda}:global(.check-feedback){padding:.8rem;border-left:3px solid var(--cinnabar);color:var(--muted);background:rgba(255,255,255,.35);font-size:.85rem}:global(.check-feedback strong){margin-right:.5rem;color:var(--ink)}:global(.check-result){display:flex;align-items:center;justify-content:space-between;padding:1rem;color:white;background:#2b2c29}:global(.check-result strong){font-family:var(--serif);font-size:1.5rem}:global(.check-result button){padding:.45rem .7rem;border:1px solid rgba(255,255,255,.3);color:white;background:transparent;cursor:pointer}
  .questions blockquote{margin:1rem 0;padding:1rem 1.2rem;border-left:3px solid var(--cinnabar);background:#e9dfcf;font-family:var(--serif);font-size:1.1rem}.source-note{display:grid;grid-template-columns:.8fr 1.2fr;gap:3rem}.source-note>p{color:var(--muted)}.chapter-pagination{display:flex;justify-content:space-between;gap:2rem;padding:3rem 0 6rem}.chapter-pagination a{display:flex;flex-direction:column;width:48%;padding:1rem;border-top:1px solid var(--line);text-decoration:none}.chapter-pagination .next{text-align:right}.chapter-pagination small{color:var(--muted)}.chapter-pagination strong{font-family:var(--serif);font-size:1.15rem}
  .unit-intro{display:grid;grid-template-columns:.7fr 1.3fr;gap:2rem;margin-bottom:1.5rem}.unit-intro h2,.workbench-section>h2{margin:.2rem 0;font-family:var(--serif);font-size:2rem}.unit-intro>p,.workbench-lead{margin:0;color:var(--muted);font-size:.88rem;line-height:1.8}.unit-list{border-top:1px solid var(--line)}.unit-list article{display:grid;grid-template-columns:90px 1fr;gap:1.2rem;padding:1.3rem 0;border-bottom:1px solid var(--line)}.unit-meta span{display:block;color:var(--cinnabar);font-family:var(--serif);font-size:1.6rem}.unit-meta small{display:inline-block;margin-top:.35rem;padding:.16rem .42rem;border-radius:99px;color:#7a5b2d;background:#eee1c5;font-size:.62rem}.unit-list h3{margin:0;font-family:var(--serif);font-size:1.25rem}.unit-question{margin:.3rem 0 1rem;color:var(--cinnabar);font-family:var(--serif)}.unit-list dl{display:grid;grid-template-columns:1fr 1fr;gap:.7rem;margin:0}.unit-list dl div{padding:.7rem;border-left:2px solid #a77734;background:rgba(255,255,255,.35)}.unit-list dl div:last-child{border-color:var(--cinnabar)}.unit-list dt{color:var(--muted);font-size:.68rem}.unit-list dd{margin:.25rem 0 0;color:var(--muted);font-size:.8rem;line-height:1.65}.unit-tags{display:flex;flex-wrap:wrap;gap:.35rem;margin-top:.75rem}.unit-tags span{padding:.15rem .45rem;border:1px solid var(--line);color:var(--muted);font-size:.68rem}.workbench-lead{margin-bottom:1.2rem}
  .unit-meta b{display:block;margin-top:.45rem;color:var(--muted);font-size:.67rem;font-weight:400}
  .deep-dive-heading{display:grid;grid-template-columns:.7fr 1.3fr;gap:.4rem 2rem;margin-bottom:1.5rem}.deep-dive-heading .eyebrow{grid-column:1/-1}.deep-dive-heading h2{margin:0;font-family:var(--serif);font-size:2rem}.deep-dive-heading>p:last-child{margin:0;color:var(--muted);font-size:.88rem;line-height:1.8}
  @media(max-width:800px){.hero-grid,.chapter-layout{grid-template-columns:1fr;gap:2rem}.toc{position:static;display:none}.workflow ol,.provenance{grid-template-columns:repeat(2,1fr)}}@media(max-width:560px){.section-map,.evidence-pair,.workflow ol,.provenance,:global(.check-options),.source-note,.unit-intro,.unit-list dl,.deep-dive-heading{grid-template-columns:1fr}.unit-list article{grid-template-columns:55px 1fr}.chapter-pagination{flex-direction:column}.chapter-pagination a{width:100%}}
  /* calmer chapter reading layout */
  .chapter-hero{padding:3.5rem 0 3.25rem;background:linear-gradient(125deg,rgba(163,59,43,.055),transparent 48%)}
  .crumbs{margin-bottom:2.5rem}
  .hero-grid{grid-template-columns:1.45fr .55fr;gap:clamp(3rem,7vw,7rem)}
  .chapter-hero h1{margin:.25rem 0 .6rem;font-size:clamp(3rem,5.5vw,5rem);font-weight:650;letter-spacing:-.035em;line-height:1.15}
  .guiding{margin-bottom:0;font-size:1.12rem}
  .chapter-hero aside{padding:1.15rem 1.25rem;border-radius:10px;background:rgba(252,251,247,.7);box-shadow:var(--shadow-soft)}
  .chapter-hero dl div{padding-left:.7rem;border:0;border-left:1px solid var(--line)}
  .chapter-hero dl div:first-child{padding-left:0;border:0}
  .chapter-layout{grid-template-columns:190px minmax(0,1fr);gap:clamp(3rem,6vw,5.5rem);padding-top:3.5rem}
  .toc{top:96px;padding:.7rem;border:1px solid var(--line);border-radius:9px;background:rgba(252,251,247,.56);box-shadow:0 8px 24px rgba(36,42,37,.035)}
  .toc small{padding:.45rem .55rem .7rem;letter-spacing:.08em}
  .toc a{position:relative;padding:.42rem .55rem;border:0;border-radius:5px;font-size:.75rem}
  .toc a:hover{color:var(--ink);background:rgba(31,39,34,.045)}
  .toc a[aria-current="location"]{color:var(--cinnabar);background:rgba(163,59,43,.07)}
  .toc a[aria-current="location"]::before{content:"";position:absolute;left:-.72rem;top:.55rem;width:3px;height:1rem;border-radius:2px;background:var(--cinnabar)}
  .provenance{gap:1px;overflow:hidden;border:1px solid var(--line);border-radius:9px;background:var(--line)}
  .provenance>div{border:0;background:var(--white)}
  .content-identity span{border:0;border-radius:99px;background:#ebe5da}
  .unit-list{display:grid;gap:.85rem;border:0}
  .unit-list article{grid-template-columns:76px 1fr;padding:1.25rem;border:1px solid var(--line);border-radius:10px;background:rgba(252,251,247,.56)}
  .unit-list dl div{padding:.75rem;border:0;border-radius:6px;background:#efebe2}
  .unit-list dl div:last-child{background:#f1e6e1}
  .unit-tags span{border:0}
  @media(max-width:800px){.chapter-layout{grid-template-columns:1fr}.hero-grid{grid-template-columns:1fr;gap:2rem}}
</style>

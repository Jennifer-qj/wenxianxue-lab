---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SearchExplorer from "../../components/SearchExplorer";
import type { SearchItem } from "../../components/SearchExplorer";
import { getCollection } from "astro:content";
import { chapters } from "../../data/site";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const [outline, concepts, quizzes, labs, deepdives] = await Promise.all([
  getCollection("outline"), getCollection("concepts"), getCollection("quiz"), getCollection("labs"), getCollection("deepdives"),
]);
const statusName = { not_started: "未开始", drafting: "整理中", pending_review: "待复核", reviewed: "已复核", verified: "已核验" } as const;
const outlineItems = outline.flatMap((entry) => entry.data.items);
const items: SearchItem[] = [
  ...chapters.map((chapter, index) => ({ id: chapter.id, type: "chapter" as const, chapter: index + 1, title: chapter.title, text: chapter.focus, meta: chapter.sections.join(" · "), href: `${base}chapters/${chapter.id}/`, status: chapter.review })),
  ...outlineItems.map((unit) => ({ id: unit.id, type: "unit" as const, chapter: unit.chapter, title: unit.subsection ?? unit.section, text: `${unit.key_question} ${unit.summary} 判断边界：${unit.boundary}`, meta: unit.chapter_title, href: `${base}chapters/ch${String(unit.chapter).padStart(2, "0")}/#${unit.id}`, status: statusName[unit.status] })),
  ...concepts.flatMap((entry) => entry.data.items).map((concept) => ({ id: concept.id, type: "concept" as const, chapter: Number(concept.chapter_ids[0]?.slice(2) ?? 1), title: concept.label, text: concept.definition, meta: `${concept.type} · ${concept.chapter_ids.map((id) => `第${Number(id.slice(2))}章`).join("、")}`, href: `${base}concepts/${concept.id}/`, status: statusName[concept.status] })),
  ...quizzes.flatMap((entry) => entry.data.items).map((quiz) => ({ id: quiz.id, type: "quiz" as const, chapter: quiz.chapter, title: quiz.prompt, text: quiz.explanation, meta: quiz.type, href: `${base}chapters/ch${String(quiz.chapter).padStart(2, "0")}/#check` })),
  ...labs.flatMap((entry) => entry.data.items.map((lab) => ({ id: lab.id, type: "lab" as const, chapter: Number(entry.id.slice(2)), title: lab.title, text: `关联 ${lab.concept_ids.length} 个概念的${lab.engine}互动案例`, meta: lab.engine, href: `${base}lab/#case-gallery` }))),
  { id: "rare-book-dossier", type: "lab" as const, chapter: 5, title: "古籍鉴定综合案卷", text: "综合纸张、装帧、牌记、避讳、刻工、版式、目录和递藏证据，形成并导出有限度鉴定意见。", meta: "综合证据推理", href: `${base}lab/#rare-book-dossier` },
  ...deepdives.flatMap((entry) => entry.data.items).map((study) => ({ id: study.id, type: "deepdive" as const, chapter: study.chapter, title: study.title, text: `${study.scenario} ${study.question}`, meta: study.deliverable, href: `${base}chapters/ch${String(study.chapter).padStart(2, "0")}/#deep-dive`, status: statusName[study.status] })),
];
---

<BaseLayout title="全站搜索" description="搜索文献学实验室的十四章、学习单元、概念、题目、实验与深度研读" active="search">
  <header class="page-hero container"><p class="eyebrow">Search the laboratory</p><h1 class="display-title">从一个词，进入全书的<em>知识现场</em></h1><p>一次检索覆盖章节、143 个学习单元、176 个概念、134 道题、实验与深度研读；所有结果都能回到具体学习位置。</p></header>
  <main class="container search-area"><SearchExplorer items={items} client:load /></main>
</BaseLayout>

<style>
  .page-hero{padding:7rem 0 4rem}.page-hero>p:last-child{max-width:50rem;color:var(--muted)}.search-area{padding-bottom:7rem}
  :global(.search-console){display:grid;grid-template-columns:1fr 190px;gap:1rem;padding:1.2rem;border:1px solid var(--line);background:#e9dfcf}:global(.search-console label span){display:block;margin-bottom:.35rem;color:var(--muted);font-size:.7rem}:global(.search-console input),:global(.search-console select){width:100%;height:48px;padding:.6rem .8rem;border:1px solid #c8b79d;background:#fffaf0;font:inherit}:global(.search-types){grid-column:1/-1;display:flex;gap:.4rem;flex-wrap:wrap}:global(.search-types button){padding:.4rem .7rem;border:1px solid var(--line);background:rgba(255,255,255,.4);cursor:pointer}:global(.search-types button.active){color:#fff;background:var(--cinnabar)}
  :global(.result-summary){display:flex;align-items:baseline;gap:.5rem;padding:1.2rem 0;border-bottom:1px solid var(--line)}:global(.result-summary strong){font-family:var(--serif);font-size:2rem;color:var(--cinnabar)}:global(.result-summary span),:global(.result-summary small){color:var(--muted)}:global(.result-summary small){margin-left:auto}
  :global(.search-results){display:grid;grid-template-columns:repeat(2,1fr);border-left:1px solid var(--line)}:global(.search-results>a){position:relative;min-height:220px;padding:1.2rem 1.2rem 3rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line);text-decoration:none;background:rgba(255,255,255,.25)}:global(.search-results>a:hover){z-index:1;background:#fffaf0;box-shadow:var(--shadow)}:global(.search-results>a>div){display:flex;gap:.5rem;align-items:center;flex-wrap:wrap}:global(.search-results>a>div span),:global(.search-results>a>div em){padding:.1rem .45rem;border-radius:99px;font-size:.65rem;font-style:normal}:global(.search-results>a>div span){color:#fff;background:var(--cinnabar)}:global(.search-results>a>div em){color:#7a5b2d;background:#eee1c5}:global(.search-results>a small){color:var(--muted)}:global(.search-results h2){margin:.7rem 0 .35rem;font-family:var(--serif);font-size:1.25rem}:global(.search-results p){margin:0;color:var(--muted);font-size:.82rem;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}:global(.search-results b){position:absolute;left:1.2rem;bottom:1rem;color:var(--cinnabar);font-size:.75rem}:global(.no-results){grid-column:1/-1;padding:5rem;text-align:center}:global(.no-results strong){font-family:var(--serif);font-size:1.5rem}:global(.no-results p){color:var(--muted)}:global(.no-results button){padding:.5rem .8rem;border:0;background:var(--cinnabar);color:#fff}
  @media(max-width:680px){.page-hero{padding:4rem 0 3rem}:global(.search-console),:global(.search-results){grid-template-columns:1fr}:global(.search-types){grid-column:auto}:global(.result-summary small){display:none}}
</style>

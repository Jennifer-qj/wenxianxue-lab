---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const [conceptFiles, graphFiles, outlineFiles] = await Promise.all([getCollection("concepts"), getCollection("graph"), getCollection("outline")]);
const counts = {
  concepts: conceptFiles.flatMap((entry) => entry.data.items).length,
  edges: graphFiles.flatMap((entry) => entry.data.items).length,
  units: outlineFiles.flatMap((entry) => entry.data.items).length,
};
---

<BaseLayout title="更新日志与路线图" description="文献学实验室的版本记录、后续路线与开放元数据下载">
  <header class="updates-hero"><div class="container"><p class="eyebrow">CHANGELOG · ROADMAP · OPEN DATA</p><h1 class="display-title">项目不是成品箱，<em>而是一份可核验的生长记录</em></h1><p>这里说明网站已经做了什么、还欠什么，以及哪些结构化成果可以下载检查。</p></div></header>
  <div class="updates-main container">
    <section class="open-data">
      <div><p class="eyebrow">Open metadata</p><h2>开放学习元数据</h2><p>可下载全书概念、关系和学习单元索引。数据不含原书全文，也不包含访客数据。</p></div>
      <div class="data-stats"><span><strong>{counts.concepts}</strong>概念</span><span><strong>{counts.edges}</strong>关系</span><span><strong>{counts.units}</strong>学习单元</span></div>
      <a href={`${base}data/knowledge.json`} download>下载 knowledge.json ↓</a>
    </section>

    <div class="updates-grid">
      <article>
        <p class="eyebrow">Released</p><h2>更新日志</h2>
        <ol class="release-list">
          <li><time>2026-08-27 · v0.6.0</time><h3>把十四章复盘收束成一份个人学习成果</h3><p>学习进度页新增个人成果册：按真实本地记录生成十四章成果脊柱、六维学习证据画像和待追问题索引，并给出可复制的阶段成果说明。画像只计算任务轨迹、综合练习与深度研读覆盖，不冒充能力认证；完整 Markdown 报告会同时带走十四章的认识、证据边界与下一步问题。</p></li>
          <li><time>2026-08-27 · v0.5.0</time><h3>让十四章各自形成一条完整的学习路线</h3><p>全部章节新增速览、标准与深研三档预计用时，以及从定位问题到章末复盘的六步任务地图；案例和检测结果会自动回写，其他阅读动作可由读者手动确认。章末新增“认识—证据边界—待核问题”三段式复盘和 Markdown 成果导出，统一 JSON 档案同步升级；同时把漏计的证据称量室纳入统计，统一为九项旗舰实验、54 个学习活动。</p></li>
          <li><time>2026-08-27 · v0.4.1</time><h3>把零散记录接回一条连续的学习线索</h3><p>首页新增基于本地档案的续学入口，能够恢复最近浏览并显示完成数、札记与今日复习；共校反馈会在读者选中章节内容时自动携带学习单元编号、审核状态和内容类型。进度页新增可阅读的 Markdown 学习报告，并修正八项旗舰实验的总数显示。</p></li>
          <li><time>2026-08-27 · v0.4.0</time><h3>让共校、校勘与来源链真正可以操作</h3><p>公开共校页开始读取真实 GitHub Issue，提供状态统计、最近议题和十四章修订索引；互动实验室新增校勘工作台与版本谱系推理，要求写出校勘记和亲缘假说。143 个学习单元增加来源、复核、机器标识和版本身份，十四章全部补齐作者阅读旁注，并纠正第八章旁注误置的目录学内容。</p></li>
          <li><time>2026-08-27 · v0.3.0</time><h3>从功能集合走向可解释的学习过程</h3><p>旗舰鉴定案卷加入判断理由、信心校准、撤回修订与决策轨迹报告；知识图谱新增三条四站式问题导览；第2、5、6、8、14章增加作者阅读旁注。反馈抽屉能够携带页面选文和问题说明，共校页与 GitHub Issue 建立五级公开处理状态。</p></li>
          <li><time>2026-08-27 · v0.2.0</time><h3>结构化公测版封版</h3><p>清理九类页面中的重复正文地标，改善读屏器与页面结构识别；页脚新增统一版本号、更新时间和更新日志入口。完成核心页面巡检，并把后续内容复核、真实读者测试和图像许可工作留入公开路线图。</p></li>
          <li><time>2026-08 · 第十三轮</time><h3>把复核提示、互动判断和项目语气再做实一层</h3><p>第3—14章补齐专属纸本核对包，第2—14章共覆盖 134 个待核验单元；互动实验室新增四案卷“证据称量室”。首页、路径页、实验室与方法页改为更具体的个人读书叙事，并增加编辑术语门禁、滚动显现和键盘焦点反馈。</p></li>
          <li><time>2026-08 · 第十二轮</time><h3>从“等待人工核验”走向真正可执行的复核</h3><p>十四章新增逐条纸本复核工作台，支持本地勾选、证据记录、阶段判断、筛选与快照导出；第二章建立 14 条专属核对重点。共校页加入不虚构数据的公开成果台账，并新增六任务可用性测试、匿名结果导出和主持手册。</p></li>
          <li><time>2026-08 · 第十一轮</time><h3>从公开网站走向可展示、可参与的成熟项目</h3><p>完成公开反馈与章节共校、内容来源与版本历史、十九道开放题三级答案、手机图谱手势与游戏替代操作、无障碍说明；新增三分钟项目展示、英文摘要、项目报告和面试演示脚本。</p></li>
          <li><time>2026-08 · 第十轮</time><h3>从个人复核走向公开共校</h3><p>全站加入页面级反馈入口、公开参与规则和十四章认领机制；概念与学习单元显示来源身份、复核阶段、结构化数据、Git 修改历史和定向纠错入口，让内容形成过程可以被追踪。</p></li>
          <li><time>2026-08 · 第九轮</time><h3>让项目作者与内容来历真正可见</h3><p>首页从功能宣传改为第一人称读书实验叙事，新增作者手记与制作流程；章节页明确区分原书目录框架、项目原创转述、教学情境、人机协作草稿和纸本核验状态，并补充隐私、纠错、权利通知及公开使用边界。第一、第五、第七章分别加入阅读草图、鉴定案卷和著录卡式专属入口，开始打破十四章完全一致的页面模板。</p></li>
          <li><time>2026-08 · 第八轮</time><h3>让内容质量和研究判断都可见</h3><p>建立十四章学术结构审计、公开人工纸本复核队列，并把审计加入发布门禁；十四个深度研读案例加入竞争性结论、关键证据缺口与三类自适应追问，取消“全选证据即完成”的机械逻辑。</p></li>
          <li><time>2026-08 · 第七轮</time><h3>从学习记录走向个人知识工作台</h3><p>新增全站随身札记、页面收藏、最近浏览和独立学习工作台；统一档案可备份这些本地记录。搜索升级为相关度排序、同义入口、近似纠错与复核状态筛选；简答题加入保留原答、逐项量规自评与返回重写闭环。</p></li>
          <li><time>2026-08 · 第六轮</time><h3>从个人网站走向可维护的公开项目</h3><p>新增友好 404、应用清单、打印与减少动态效果支持；补齐引用文件、贡献规范、问题模板、依赖维护与 Pull Request 质量检查，并制作一页式作品集 PDF 和实际操作演示视频。</p></li>
          <li><time>2026-08 · 第五轮</time><h3>让项目更容易被看见和介绍</h3><p>新增标准 PNG 社交分享卡、LearningResource 结构化数据、站点地图与搜索引擎说明，并生成六张经过检查的作品集展示截图。</p></li>
          <li><time>2026-08 · 第四轮</time><h3>把“如何使用”纳入产品本身</h3><p>新增永久使用指南、十分钟体验路线、功能地图与常见问题；首次访问引导可以随时重新打开，并补充项目介绍推文与作品集文案。</p></li>
          <li><time>2026-08 · 第三轮</time><h3>从“完成率”走向掌握度</h3><p>加入章节掌握度、连续学习、间隔复习推荐；知识图谱新增最短路径和子图导出；加入首次访问引导与开放元数据。</p></li>
          <li><time>2026-08 · 第二轮</time><h3>概念档案与综合鉴定案卷</h3><p>建立全书概念详情页，把多章知识放进一份可反复推理的古籍综合案卷，并补充题后诊断反馈。</p></li>
          <li><time>2026-08 · 第一轮</time><h3>十四章进入结构化系统</h3><p>完成章节学习页、学习路径、知识图谱、搜索、进度档案和多种非选择题互动实验的基础架构。</p></li>
        </ol>
      </article>
      <aside>
        <p class="eyebrow">Next</p><h2>后续路线图</h2>
        <ul class="roadmap-list">
          <li><b>持续进行</b><span>依据纸本逐条复核十四章表述和页码，并生成待复核清单。</span></li>
          <li><b>下一阶段</b><span>增加真实古籍图像许可来源、图像标注和版本对勘案例。</span></li>
          <li><b>下一阶段</b><span>邀请真实读者使用固定六任务完成首轮测试，并公开高频阻碍与修复结果。</span></li>
          <li><b>研究输出</b><span>根据使用反馈完善项目报告，并建立阶段版本归档。</span></li>
          <li><b>暂不接入</b><span>登录、用户画像及第三方访客追踪；保持轻量和隐私友好。</span></li>
        </ul>
      </aside>
    </div>
    <section class="release-standard"><p class="eyebrow">Release standard</p><h2>什么才算“可以发布”？</h2><div><span>内容结构通过模式校验</span><span>站内链接无断链</span><span>核心交互自动测试通过</span><span>公开文件无原书全文</span><span>待复核结论明确标注</span></div><a href={`${base}about/`}>查看完整研究方法与版权边界 →</a></section>
  </div>
</BaseLayout>

<style>
  .updates-hero{padding:7rem 0 4rem;border-bottom:1px solid var(--line);background:linear-gradient(135deg,rgba(83,107,112,.12),transparent 58%)}.updates-hero p:not(.eyebrow){max-width:50rem;color:var(--muted);font-family:var(--serif);font-size:1.05rem;line-height:1.8}.updates-main{padding-block:3rem 7rem}.open-data{display:grid;grid-template-columns:1fr auto auto;gap:2rem;align-items:center;padding:1.5rem;border:1px solid var(--line);background:#fffaf0}.open-data h2,.updates-grid h2,.release-standard h2{margin:.2rem 0 .55rem;font-family:var(--serif);font-size:2rem}.open-data p{margin:0;color:var(--muted)}.data-stats{display:flex;gap:1.5rem}.data-stats span{color:var(--muted);font-size:.7rem}.data-stats strong{display:block;color:var(--cinnabar);font-family:var(--serif);font-size:1.7rem}.open-data>a{padding:.7rem .9rem;color:#fff7e9;background:var(--cinnabar);text-decoration:none;white-space:nowrap}.updates-grid{display:grid;grid-template-columns:1.4fr .8fr;gap:4rem;margin-top:4rem}.release-list{padding:0;list-style:none}.release-list li{position:relative;padding:0 0 2.5rem 1.5rem;border-left:1px solid var(--line)}.release-list li::before{position:absolute;top:.2rem;left:-5px;width:9px;height:9px;border-radius:50%;background:var(--cinnabar);content:""}.release-list time{color:var(--cinnabar);font-size:.7rem}.release-list h3{margin:.25rem 0;font-family:var(--serif);font-size:1.25rem}.release-list p,.roadmap-list span{color:var(--muted);font-size:.82rem;line-height:1.7}.roadmap-list{display:grid;gap:.65rem;padding:0;list-style:none}.roadmap-list li{padding:.9rem;border:1px solid var(--line);background:rgba(255,255,255,.35)}.roadmap-list b,.roadmap-list span{display:block}.roadmap-list b{margin-bottom:.3rem;color:var(--cinnabar)}.release-standard{margin-top:4rem;padding-top:3rem;border-top:1px solid var(--line)}.release-standard>div{display:flex;flex-wrap:wrap;gap:.5rem;margin:1.2rem 0}.release-standard span{padding:.5rem .7rem;border:1px solid var(--line);background:#fffaf0;font-size:.76rem}.release-standard a{color:var(--cinnabar)}@media(max-width:850px){.open-data{grid-template-columns:1fr}.data-stats{flex-wrap:wrap}.updates-grid{grid-template-columns:1fr;gap:2rem}}
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectTour from "../../components/ProjectTour";
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<BaseLayout title="十分钟项目导览" description="亲手走过文献学实验室从阅读、证据判断、知识连接到学习成果的完整闭环" active="tour">
  <header class="tour-hero">
    <div class="container tour-hero-grid">
      <div><p class="eyebrow">10-MINUTE PROJECT TOUR</p><h1 class="display-title">别急着数它有多少页面，<br /><em>先亲手走完一条线</em></h1><p>我挑了一个最能说明问题的小案例。你会先猜，再看证据怎样迫使自己改口，最后留下一句只属于这次阅读的复盘。</p></div>
      <aside><small>这十分钟会经过</small><ol><li>一本书为何不能只做成电子书</li><li>一章怎样拆成学习任务</li><li>一条证据怎样限制结论</li><li>一次学习怎样进入成果册</li></ol><span>无需登录 · 不上传记录 · 可随时重来</span></aside>
    </div>
  </header>
  <div class="tour-main container">
    <ProjectTour baseUrl={base} client:load />
    <aside class="tour-after"><div><p class="eyebrow">走完以后</p><h2>按照你的目的继续</h2></div><nav><a href={`${base}paths/`}><b>我要系统学习</b><span>从七条路径选择一个学习目标 →</span></a><a href={`${base}lab/`}><b>我要继续动手</b><span>进入九项技能实验和两项跨章案卷 →</span></a><a href={`${base}showcase/`}><b>我要了解项目方法</b><span>查看三分钟展示与成果证据 →</span></a></nav></aside>
  </div>
</BaseLayout>

<style>
  .tour-hero{padding:6.5rem 0 4rem;color:#f8f1e5;background:radial-gradient(circle at 82% 20%,rgba(190,118,84,.22),transparent 28%),#22312a}.tour-hero-grid{display:grid;grid-template-columns:1.2fr .65fr;gap:6rem;align-items:end}.tour-hero h1{margin:.5rem 0}.tour-hero p:not(.eyebrow){max-width:48rem;color:#c3cdc7;font-family:var(--serif);line-height:1.9}.tour-hero aside{padding:1.5rem;border:1px solid rgba(255,255,255,.16);border-radius:12px;background:rgba(255,255,255,.04)}.tour-hero aside>small{color:#e1a68d;letter-spacing:.12em}.tour-hero ol{padding-left:1.2rem;color:#d9dedb;font-family:var(--serif);line-height:2}.tour-hero aside>span{color:#98aaa1;font-size:.7rem}.tour-main{padding-block:4rem 7rem}.tour-workbench{scroll-margin-top:100px;overflow:hidden;border:1px solid var(--line);border-radius:16px;background:var(--white);box-shadow:var(--shadow)}
  :global(.tour-board-head){display:flex;align-items:end;justify-content:space-between;gap:2rem;padding:1.5rem 1.8rem;color:#f7f0e4;background:#293832}:global(.tour-board-head small){color:#dda48d;letter-spacing:.14em}:global(.tour-board-head h2){max-width:760px;margin:.25rem 0 0;font-family:var(--serif);font-size:1.7rem}:global(.tour-progress){display:flex;align-items:baseline;white-space:nowrap}:global(.tour-progress strong){font-family:var(--serif);font-size:2.2rem}:global(.tour-progress span){color:#9eaaa4}:global(.tour-meter){height:4px;background:#d8d0c3}:global(.tour-meter i){display:block;height:100%;background:var(--cinnabar);transition:width .35s ease}
  :global(.tour-stepper){display:grid;grid-template-columns:repeat(6,1fr);border-bottom:1px solid var(--line);background:#eee7db}:global(.tour-stepper button){display:grid;gap:.12rem;padding:.8rem;text-align:left;border:0;border-right:1px solid var(--line);color:var(--muted);background:transparent;cursor:pointer}:global(.tour-stepper button:last-child){border-right:0}:global(.tour-stepper button span){color:#9b8b79;font-family:var(--serif)}:global(.tour-stepper button b){font-family:var(--serif);font-size:.78rem}:global(.tour-stepper button small){font-size:.6rem}:global(.tour-stepper button.active){color:#fff;background:var(--cinnabar)}:global(.tour-stepper button.active span),:global(.tour-stepper button.active small){color:#f2c8b8}:global(.tour-stepper button.visited:not(.active)){color:#33483e;background:#dfe5dd}
  :global(.tour-scene){min-height:500px;padding:3.2rem clamp(1.2rem,5vw,5rem)}:global(.tour-scene article){animation:tour-in .35s ease}:global(.tour-kicker){margin:0;color:var(--cinnabar);font-size:.72rem;font-weight:700;letter-spacing:.08em}:global(.tour-scene h3){max-width:760px;margin:.5rem 0 1.2rem;font-family:var(--serif);font-size:clamp(1.75rem,3vw,2.65rem);line-height:1.35}:global(.tour-scene article>p:not(.tour-kicker,.tour-side-note)){max-width:820px;color:var(--muted);font-family:var(--serif);line-height:1.95}:global(.tour-contrast){display:grid;grid-template-columns:1fr auto 1fr;gap:1.2rem;align-items:center;max-width:800px;margin:2rem 0}:global(.tour-contrast span){padding:1.2rem;border:1px solid var(--line);border-radius:9px;background:#f3eee5}:global(.tour-contrast strong),:global(.tour-contrast del),:global(.tour-contrast small){display:block}:global(.tour-contrast small){margin-top:.45rem;color:var(--muted);font-size:.7rem}:global(.tour-contrast>i){color:var(--cinnabar);font-style:normal}
  :global(.tour-chapter-map){display:flex;align-items:stretch;gap:.45rem;margin:2rem 0}:global(.tour-chapter-map span){flex:1;padding:1rem .7rem;border-top:3px solid var(--cinnabar);background:#eee6d9}:global(.tour-chapter-map b),:global(.tour-chapter-map small){display:block}:global(.tour-chapter-map b){font-family:var(--serif)}:global(.tour-chapter-map small){margin-top:.35rem;color:var(--muted);font-size:.65rem}:global(.tour-chapter-map i){align-self:center;color:var(--cinnabar);font-style:normal}:global(.tour-side-note){max-width:800px;padding:.75rem .9rem;border-left:3px solid #71857a;background:#e8ece7;color:var(--muted);font-size:.75rem;line-height:1.7}:global(.tour-source-link){display:inline-block;margin-top:.7rem;color:var(--cinnabar);font-size:.76rem}
  :global(.tour-scene blockquote){max-width:720px;margin:1.6rem 0;padding:1.2rem 1.4rem;border-left:3px solid var(--cinnabar);background:#f1e9dc;font-family:var(--serif);font-size:1.1rem}:global(.tour-evidence-choices){display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem;max-width:850px}:global(.tour-evidence-choices button){padding:1rem;text-align:left;border:1px solid var(--line);border-radius:8px;background:#fffaf0;cursor:pointer}:global(.tour-evidence-choices button.selected){color:#fff;border-color:#33483e;background:#33483e}:global(.tour-evidence-choices b),:global(.tour-evidence-choices small){display:block}:global(.tour-evidence-choices b){font-family:var(--serif)}:global(.tour-evidence-choices small){margin-top:.3rem;color:inherit;opacity:.72}:global(.tour-diagnosis){max-width:850px;margin-top:.8rem;padding:1rem;border-left:4px solid #9f584c;background:#f2dfda}:global(.tour-diagnosis.good){border-color:#5c8066;background:#e3eee3}:global(.tour-diagnosis p){margin:.3rem 0;color:var(--muted);font-size:.78rem;line-height:1.7}
  :global(.tour-mini-graph){position:relative;width:min(760px,100%);height:260px;margin:1.5rem 0;border:1px solid var(--line);border-radius:12px;background:radial-gradient(circle,#e1d7c8 1px,transparent 1px);background-size:20px 20px}:global(.tour-mini-graph .node){position:absolute;z-index:2;display:grid;place-items:center;padding:.5rem .7rem;border:1px solid #71857a;border-radius:999px;background:#f9f6ef;font-size:.75rem}:global(.tour-mini-graph .main){left:42%;top:40%;padding:.8rem 1rem;color:#fff;background:#33483e}:global(.tour-mini-graph .n1){left:8%;top:14%}:global(.tour-mini-graph .n2){left:67%;top:9%}:global(.tour-mini-graph .n3){left:76%;top:67%}:global(.tour-mini-graph .n4){left:11%;top:71%}:global(.tour-mini-graph .n5){left:42%;top:78%}:global(.tour-mini-graph .edge){position:absolute;z-index:1;left:47%;top:48%;width:32%;height:1px;background:#9a8d7d;transform-origin:left}:global(.tour-mini-graph .e1){width:42%;transform:rotate(-153deg)}:global(.tour-mini-graph .e2){width:30%;transform:rotate(-39deg)}:global(.tour-mini-graph .e3){width:34%;transform:rotate(31deg)}:global(.tour-mini-graph .e4){width:39%;transform:rotate(151deg)}:global(.tour-mini-graph .e5){width:32%;transform:rotate(90deg)}
  :global(.tour-reflection){display:grid;gap:.55rem;max-width:850px}:global(.tour-reflection>span){font-family:var(--serif);font-weight:700}:global(.tour-reflection textarea){min-height:150px;padding:1rem;border:1px solid var(--line);border-radius:8px;background:#fffaf0;color:var(--ink);font:inherit;line-height:1.7;resize:vertical}:global(.tour-reflection small){color:#9f584c}:global(.tour-reflection small.ready){color:#47644e}:global(.tour-output){max-width:850px;padding:1.2rem;border:1px solid var(--line);border-radius:10px;background:#f2ece2}:global(.tour-output>small){color:var(--cinnabar);letter-spacing:.1em}:global(.tour-output dl){margin-bottom:0}:global(.tour-output dl div){display:grid;grid-template-columns:5rem 1fr;gap:1rem;padding:.65rem 0;border-top:1px solid var(--line)}:global(.tour-output dt){font-family:var(--serif);font-weight:700}:global(.tour-output dd){margin:0;color:var(--muted);font-size:.78rem}:global(.tour-final-actions){display:flex;flex-wrap:wrap;gap:.6rem;margin:1rem 0}:global(.tour-final-actions button),:global(.tour-final-actions a){padding:.7rem 1rem;border:1px solid var(--cinnabar);border-radius:999px;color:#fff;background:var(--cinnabar);font:inherit;font-size:.78rem;text-decoration:none;cursor:pointer}:global(.tour-final-actions a){color:var(--cinnabar);background:transparent}:global(.tour-final-actions button:disabled){opacity:.4;cursor:not-allowed}
  :global(.tour-controls){display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.5rem;border-top:1px solid var(--line);background:#eee7db}:global(.tour-controls span){color:var(--muted);font-size:.7rem}:global(.tour-controls button){min-height:42px;padding:.55rem .8rem;border:1px solid var(--line);border-radius:999px;background:transparent;font:inherit;cursor:pointer}:global(.tour-controls button.primary){color:#fff;border-color:var(--cinnabar);background:var(--cinnabar)}:global(.tour-controls button:disabled){opacity:.35;cursor:not-allowed}.tour-after{display:grid;grid-template-columns:.65fr 1.35fr;gap:4rem;margin-top:5rem;padding-top:3rem;border-top:1px solid var(--line)}.tour-after h2{margin:.2rem 0;font-family:var(--serif);font-size:2rem}.tour-after nav{display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem}.tour-after a{display:flex;flex-direction:column;padding:1rem;border:1px solid var(--line);border-radius:8px;background:var(--white);text-decoration:none}.tour-after b{font-family:var(--serif)}.tour-after span{margin-top:.4rem;color:var(--muted);font-size:.7rem}
  @keyframes tour-in{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}@media(prefers-reduced-motion:reduce){:global(.tour-scene article){animation:none}:global(.tour-meter i){transition:none}}@media(max-width:850px){.tour-hero-grid,.tour-after{grid-template-columns:1fr;gap:2rem}:global(.tour-stepper){display:flex;overflow-x:auto}:global(.tour-stepper button){min-width:130px}:global(.tour-chapter-map){display:grid;grid-template-columns:1fr}:global(.tour-chapter-map i){display:none}.tour-after nav{grid-template-columns:1fr}}@media(max-width:600px){.tour-hero{padding:4rem 0 3rem}.tour-hero h1 br{display:none}:global(.tour-board-head){align-items:start;flex-direction:column}:global(.tour-scene){min-height:0;padding:2rem 1rem}:global(.tour-contrast),:global(.tour-evidence-choices){grid-template-columns:1fr}:global(.tour-contrast>i){transform:rotate(90deg);justify-self:center}:global(.tour-mini-graph){height:320px}:global(.tour-mini-graph .main){left:34%;top:42%}:global(.tour-mini-graph .n2){left:60%}:global(.tour-mini-graph .n3){left:62%;top:74%}:global(.tour-mini-graph .n5){left:32%;top:84%}:global(.tour-controls){align-items:stretch;flex-direction:column}:global(.tour-controls span){order:-1}:global(.tour-controls button){width:100%}}
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { chapters } from "../../data/site";
import CommunityLedger from "../../components/CommunityLedger";
const issueBase = "https://github.com/Jennifer-qj/wenxianxue-lab/issues/new";
const stages = [
  ["01", "发现与提交", "指出具体页面、短句或知识点，并说明问题类型。"],
  ["02", "提供依据", "给出纸本页码、书目信息或可靠研究来源，不上传扫描件。"],
  ["03", "公开讨论", "问题进入 GitHub 队列；不同意见保留证据与讨论过程。"],
  ["04", "作者确认", "项目作者完成最终判断，记录接受、部分接受或暂不采纳。"],
  ["05", "更新与致谢", "修改进入版本历史；经同意后在贡献记录中公开署名。"],
];
const reviewStates = [
  ["新提交", "确认页面、问题类型与版权边界", "status: needs-triage"],
  ["需要依据", "问题已定位，等待纸本页码或可靠来源", "status: needs-evidence"],
  ["核对中", "已有证据，正在比较表述与判断范围", "status: in-review"],
  ["已采用", "修改已进入代码与公开版本记录", "status: accepted"],
  ["保留异议", "证据尚不足以修改，讨论仍公开保留", "status: declined"],
];
---
<BaseLayout title="参与共校" description="参与文献学实验室的内容复核、知识纠错和功能改进" active="about">
  <header class="contribute-hero">
    <div class="container">
      <p class="eyebrow">OPEN REVIEW · 公开共校</p>
      <h1 class="display-title">让一次阅读，成为一条<em>可追踪的修订</em></h1>
      <p>你不需要替项目重写一章。核对一个专名、指出一条证据、复现一次交互问题，都可以成为有记录的贡献。</p>
      <div class="hero-actions"><a class="button" href={`${issueBase}?template=content-correction.yml&title=${encodeURIComponent("[内容纠错] ")}`}>提交内容纠错 ↗</a><a class="button secondary" href={`${issueBase}?template=review-claim.yml&title=${encodeURIComponent("[共校认领] ")}`}>认领一项复核 ↗</a></div>
    </div>
  </header>
  <div class="contribute-main container">
    <section class="principles">
      <p class="eyebrow">参与原则</p><h2>不是投票决定知识，而是共同补足证据</h2>
      <div><article><strong>具体</strong><p>定位页面、知识点和需要讨论的短句。</p></article><article><strong>有据</strong><p>区分纸本依据、补充研究和个人推断。</p></article><article><strong>克制</strong><p>不上传扫描件、整本自动识别稿或大段受保护文字。</p></article><article><strong>留痕</strong><p>结论、异议和修改都保留公开处理记录。</p></article></div>
    </section>
    <section class="workflow"><p class="eyebrow">公开处理流程</p><h2>一条反馈怎样进入网站？</h2><ol>{stages.map(([number,title,text]) => <li data-step={number}><span>{number}</span><div><strong>{title}</strong><p>{text}</p></div></li>)}</ol></section>
    <section class="review-states"><header><div><p class="eyebrow">公开状态板</p><h2>提交以后，不会掉进一个看不见的邮箱</h2></div><p>每条 GitHub Issue 都可以沿以下状态移动。状态表示处理进度，不代表用投票决定学术结论。</p></header><div>{reviewStates.map(([title,description,label], index) => <article><span>{String(index + 1).padStart(2,"0")}</span><strong>{title}</strong><p>{description}</p><code>{label}</code></article>)}</div><footer><p>项目目前没有虚构处理时限。作者会在实际核对后公开结论、依据和对应版本；不同意见即使不采用，也保留在原讨论中。</p><a href="https://github.com/Jennifer-qj/wenxianxue-lab/issues" target="_blank" rel="noreferrer">查看真实公开队列 ↗</a></footer></section>
    <CommunityLedger client:load />
    <section class="chapter-claims"><header><div><p class="eyebrow">章节认领</p><h2>从你正在读的一章开始</h2></div><p>认领不意味着独占，也不要求一次核对整章；可以只说明准备检查的范围。</p></header><div>{chapters.map((chapter) => <a data-chapter={chapter.number} href={`${issueBase}?template=review-claim.yml&title=${encodeURIComponent(`[共校认领] ${chapter.number} ${chapter.title}`)}`}><small>{chapter.number}</small><strong>{chapter.title}</strong><span>创建认领记录 ↗</span></a>)}</div></section>
    <section class="rights"><div><p class="eyebrow">贡献与权利</p><h2>提交前请确认</h2></div><ul><li>提交内容为本人原创，或你有权提供。</li><li>不包含原书扫描件、整本自动识别稿或大段逐字转录。</li><li>同意项目在记录贡献来源的前提下整理、修改和采用反馈。</li><li>项目作者保留最终学术判断与合并决定。</li></ul></section>
    <section class="channels"><a href={`${issueBase}?template=content-correction.yml`}><small>学术内容</small><strong>报告知识、页码或关系问题</strong><span>打开内容纠错表单 ↗</span></a><a href={`${issueBase}?template=bug-report.yml`}><small>产品体验</small><strong>报告显示、操作或记录故障</strong><span>打开网站问题表单 ↗</span></a><a href={`${issueBase}?template=feature-request.yml`}><small>共同设计</small><strong>建议新功能或学习活动</strong><span>打开功能建议表单 ↗</span></a></section>
  </div>
</BaseLayout>
<style>
  .contribute-hero{padding:6rem 0 5rem;color:#f6f1e8;background:#24302b}.contribute-hero .display-title{max-width:900px}.contribute-hero>div>p:not(.eyebrow){max-width:48rem;color:#c5c8bf;font-family:var(--serif);font-size:1.08rem}.hero-actions{display:flex;gap:.7rem;margin-top:2rem}.contribute-hero .button{color:#24302b;background:#f5f0e7;border-color:#f5f0e7}.contribute-hero .button.secondary{color:#f5f0e7;background:transparent;border-color:rgba(255,255,255,.45)}.contribute-main{padding-block:5rem}.principles>h2,.workflow>h2,.chapter-claims h2,.rights h2{margin:.25rem 0 2rem;font-family:var(--serif);font-size:clamp(1.8rem,3vw,2.7rem)}.principles>div{display:grid;grid-template-columns:repeat(4,1fr);gap:1rem}.principles article{padding:1.3rem;border:1px solid var(--line);border-radius:10px;background:var(--white)}.principles strong{font-family:var(--serif);font-size:1.35rem}.principles p,.chapter-claims header>p{color:var(--muted);font-size:.82rem}.workflow{padding:6rem 0}.workflow ol{display:grid;grid-template-columns:repeat(5,1fr);margin:0;padding:0;list-style:none}.workflow li{display:flex;gap:.8rem;padding:1rem;border-top:1px solid var(--line)}.workflow li>span{color:var(--cinnabar);font-family:var(--serif)}.workflow strong{font-family:var(--serif)}.workflow p{color:var(--muted);font-size:.75rem}.chapter-claims{padding:4rem 0;border-block:1px solid var(--line)}.chapter-claims>header{display:grid;grid-template-columns:1fr 1fr;gap:3rem}.chapter-claims>div{display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem}.chapter-claims a{display:grid;grid-template-columns:55px 1fr auto;align-items:center;padding:1rem;border:1px solid var(--line);border-radius:8px;background:rgba(252,251,247,.6);text-decoration:none}.chapter-claims small{color:var(--cinnabar)}.chapter-claims strong{font-family:var(--serif)}.chapter-claims span{color:var(--muted);font-size:.7rem}.rights{display:grid;grid-template-columns:.7fr 1.3fr;gap:4rem;padding:5rem 0}.rights ul{margin:0;padding:1.5rem 2.5rem;border-radius:10px;background:#eae3d8}.rights li{margin:.6rem 0;color:var(--muted)}.channels{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.channels a{display:flex;min-height:190px;flex-direction:column;padding:1.4rem;border-radius:12px;color:#f5f0e7;background:#24302b;text-decoration:none}.channels small{color:#dda18b}.channels strong{margin:.6rem 0;font-family:var(--serif);font-size:1.25rem}.channels span{margin-top:auto;color:#c5c8bf;font-size:.75rem}@media(max-width:850px){.principles>div,.workflow ol{grid-template-columns:repeat(2,1fr)}.chapter-claims>header,.rights{grid-template-columns:1fr}.channels{grid-template-columns:1fr}}@media(max-width:560px){.contribute-hero{padding:4rem 0}.contribute-hero .display-title{font-size:clamp(2.2rem,10vw,3rem);word-break:break-word}.principles>h2,.workflow>h2,.chapter-claims h2,.rights h2{overflow-wrap:anywhere}.principles>div,.workflow ol,.chapter-claims>div{grid-template-columns:1fr}.chapter-claims a{grid-template-columns:45px 1fr}.chapter-claims span{grid-column:2}.hero-actions{align-items:stretch;flex-direction:column}}
  .contribution-ledger{padding:5rem 0;border-bottom:1px solid var(--line)}.contribution-ledger>header{display:flex;align-items:end;justify-content:space-between;gap:2rem}.contribution-ledger h2{margin:.25rem 0 1.4rem;font-family:var(--serif);font-size:clamp(1.8rem,3vw,2.7rem)}.ledger-counts{display:flex;gap:1.5rem;margin-bottom:1.4rem;color:var(--muted);font-size:.72rem}.ledger-counts strong{color:var(--ink);font-family:var(--serif);font-size:1.7rem}.ledger-empty{display:grid;grid-template-columns:auto 1fr auto;gap:1.5rem;align-items:center;padding:1.5rem;border:1px dashed #bdb09e;border-radius:12px;background:#eee7db}.ledger-empty>span{color:var(--cinnabar);font-family:var(--serif);font-size:2.4rem}.ledger-empty strong,.ledger-list article>strong{font-family:var(--serif);font-size:1.2rem}.ledger-empty p{max-width:45rem;margin:.35rem 0;color:var(--muted);font-size:.78rem}.ledger-empty a{color:var(--cinnabar);font-size:.72rem}.ledger-list{display:grid;gap:.7rem}.ledger-list article{display:grid;grid-template-columns:1fr 2fr 1.2fr auto;gap:1rem;padding:1rem;border:1px solid var(--line);border-radius:9px}.ledger-list small,.ledger-list span{color:var(--muted);font-size:.68rem}.ledger-list a{color:var(--cinnabar);font-size:.68rem}.contribution-ledger>footer{color:var(--muted);font-size:.68rem}@media(max-width:700px){.contribution-ledger>header{align-items:start;flex-direction:column}.ledger-counts{margin:0}.ledger-empty{grid-template-columns:auto 1fr}.ledger-empty a{grid-column:2}.ledger-list article{grid-template-columns:1fr}}
  .review-states{padding:4rem 0;border-block:1px solid var(--line)}.review-states>header{display:grid;grid-template-columns:1fr .8fr;gap:3rem;align-items:end}.review-states h2{margin:.25rem 0 1.4rem;font-family:var(--serif);font-size:clamp(1.8rem,3vw,2.7rem)}.review-states>header>p,.review-states>footer p{color:var(--muted);font-size:.78rem;line-height:1.65}.review-states>div{display:grid;grid-template-columns:repeat(5,1fr);margin-top:1rem;border-top:1px solid var(--line);border-left:1px solid var(--line)}.review-states article{display:flex;min-height:170px;flex-direction:column;padding:1rem;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(255,255,255,.35)}.review-states article>span{color:var(--cinnabar);font-family:var(--serif);font-size:1.2rem}.review-states article>strong{margin:.45rem 0;font-family:var(--serif)}.review-states article>p{margin:0;color:var(--muted);font-size:.7rem;line-height:1.55}.review-states article>code{margin-top:auto;color:#7b6753;font-size:.58rem}.review-states>footer{display:flex;align-items:center;justify-content:space-between;gap:2rem;padding:1rem;color:#f3ecdf;background:#24302b}.review-states>footer p{max-width:50rem;margin:0;color:#c2c2b9}.review-states>footer a{color:#efb79d;font-size:.72rem;white-space:nowrap}@media(max-width:850px){.review-states>header{grid-template-columns:1fr}.review-states>div{grid-template-columns:1fr}.review-states article{min-height:0}.review-states>footer{align-items:flex-start;flex-direction:column}}
</style>

---
import BaseLayout from "../../layouts/BaseLayout.astro";
import KnowledgeGraph from "../../components/KnowledgeGraph";
import { getCollection } from "astro:content";
const conceptEntries = await getCollection("concepts");
const graphEntries = await getCollection("graph");
const concepts = conceptEntries.flatMap((entry) => entry.data.items);
const edges = graphEntries.flatMap((entry) => entry.data.items);
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<BaseLayout title="知识图谱" active="graph">
  <header class="page-hero container">
    <div>
      <p class="eyebrow">Knowledge graph · 全书数据</p>
      <h1 class="display-title">追踪概念之间的<em>牵引力</em></h1>
    </div>
    <p>读取全书结构化内容，不再使用演示节点。搜索概念、筛选章节与类型、拖动节点，并沿有证据和置信度的关系跨章阅读。</p>
  </header>
  <section class="container graph-area">
    <div class="graph-stats"><span><strong>{concepts.length}</strong>个概念节点</span><span><strong>{edges.length}</strong>条关系</span><span><strong>14</strong>章均可筛选</span><a href={`${base}concepts/`}>打开完整概念词表 →</a></div>
    <KnowledgeGraph concepts={concepts} edges={edges} baseUrl={base} client:load />
  </section>
  <section class="graph-method container">
    <p class="eyebrow">Reading the graph</p>
    <div>
      <h2>图谱不是漂亮的装饰，而是另一种阅读方式</h2>
      <p>每条关系必须能回到原书或补充文献的具体依据。存在争议的关系会显示置信度和复核状态，不把推测伪装成事实。</p>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero{padding:7rem 0 3rem;display:grid;grid-template-columns:1.35fr .65fr;gap:4rem;align-items:end}.page-hero>p{color:var(--muted)}
  .graph-area{padding-bottom:5rem}.graph-stats{display:flex;align-items:baseline;gap:1.5rem;margin-bottom:1rem}.graph-stats span{display:flex;align-items:baseline;gap:.35rem;color:var(--muted);font-size:.78rem}.graph-stats strong{color:var(--cinnabar);font-family:var(--serif);font-size:1.5rem}.graph-stats a{margin-left:auto;color:var(--cinnabar);font-size:.76rem}.graph-method{padding:3rem 0 6rem;display:grid;grid-template-columns:.6fr 1.4fr;border-top:1px solid var(--line)}.graph-method h2{margin:0;font-family:var(--serif);font-size:1.7rem}.graph-method div p{color:var(--muted)}
  @media(max-width:760px){.page-hero,.graph-method{grid-template-columns:1fr;gap:1rem}}
</style>

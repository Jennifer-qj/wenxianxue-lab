---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { chapters, learningPaths } from "../../data/site";
---

<BaseLayout title="原书覆盖矩阵">
  <header class="page-hero container">
    <p class="eyebrow">Coverage matrix</p>
    <h1 class="display-title">十四章，<em>一章不漏</em></h1>
    <p>这张矩阵记录每章的学习路径、分节数量、关键词与人工复核状态。具体页码只有在纸本逐条核验后才会公开。</p>
  </header>
  <section class="schema container">
    <p class="eyebrow">Content model</p>
    <div><span>章 Chapter</span><i>→</i><span>路径 Path</span><i>→</i><span>知识点 Concept</span><i>→</i><span>活动 Activity</span><i>→</i><span>来源 Source</span><i>→</i><span>复核 Review</span></div>
  </section>
  <section class="coverage container">
    <div class="table-head"><span>原书章节</span><span>结构化内容</span><span>学习路径</span><span>纸本核验</span></div>
    {chapters.map((chapter) => (
      <article id={chapter.id}>
        <div><strong>{chapter.number}</strong><a href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/chapters/${chapter.id}/`}>{chapter.title}</a></div>
        <div><b>{chapter.sections.length} 个分节</b><p>{chapter.keywords.map((word) => `#${word}`).join("　")}</p></div>
        <span>{learningPaths.find((path) => chapter.pathIds.includes(path.id))?.title}</span>
        <div><small>{chapter.source.verified ? "页码已核验" : "页码未公开"}</small><em>{chapter.review}</em></div>
      </article>
    ))}
  </section>
</BaseLayout>
<style>
  .page-hero{padding:7rem 0 4rem}.page-hero>p:last-child{max-width:44rem;color:var(--muted)}
  .schema{padding:1.2rem 0 2rem}.schema>div{display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}.schema span{padding:.4rem .65rem;border:1px solid var(--line);background:rgba(255,255,255,.35);font-size:.75rem}.schema i{color:var(--cinnabar);font-style:normal}
  .coverage{padding-bottom:6rem}.table-head,article{display:grid;grid-template-columns:1.1fr 1.8fr 1.1fr .8fr;gap:1rem;padding:1.1rem;border-bottom:1px solid var(--line);align-items:center}
  .table-head{color:var(--muted);font-size:.72rem;letter-spacing:.08em;background:rgba(255,255,255,.25)}article>div:first-child strong,article>div:first-child a{display:block}article>div:first-child a{text-decoration:none}article>div:first-child a:hover{color:var(--cinnabar)}article strong{font-family:var(--serif)}article b{font-size:.78rem}article p{margin:.2rem 0;color:var(--muted);font-size:.72rem}article small,article em{display:block;font-style:normal}article small{color:var(--muted)}article em{width:max-content;margin-top:.25rem;padding:.1rem .4rem;border-radius:99px;color:#7a5b2d;background:#eee1c5;font-size:.65rem}
  @media(max-width:660px){.table-head{display:none}article{grid-template-columns:1fr auto}article span{grid-column:1/-1}}
</style>

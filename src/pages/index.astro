---
import BaseLayout from "../layouts/BaseLayout.astro";
import RepoPulse from "../components/RepoPulse";
import { games, graphStats, learningPaths } from "../data/site";
import { getCollection } from "astro:content";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const outlineEntries = await getCollection("outline");
const units = outlineEntries.flatMap((entry) => entry.data.items);
const verifiedUnits = units.filter((unit) => unit.status === "verified").length;
const pathReview = new Map(learningPaths.map((path) => {
  const chapterNumbers = path.chapterIds.map((id) => Number(id.slice(2)));
  const pathUnits = units.filter((unit) => chapterNumbers.includes(unit.chapter));
  const verified = pathUnits.filter((unit) => unit.status === "verified").length;
  return [path.id, { total: pathUnits.length, verified, percent: pathUnits.length ? Math.round(verified / pathUnits.length * 100) : 0 }];
}));
---

<BaseLayout active="home">
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">一份仍在生长的个人读书实验</p>
      <h1 class="display-title">我把读《文献学概要》时<br />画下的关系，做成了一座<em>学习实验室</em></h1>
      <p class="hero-lead">
        我想知道：一本专业教材除了被顺序读完，还能不能被重新连接、反复判断并亲手练习？
        于是，我从纸张与装帧、版本、校勘和目录出发，把自己的学习过程逐步转化成这座网站。
      </p>
      <div class="hero-actions">
        <a class="button" href={`${base}paths/`}>开始第一条学习路径 <span>→</span></a>
        <a class="button secondary" href={`${base}story/`}>先读我的制作手记</a>
      </div>
      <p class="hero-boundary">这不是原书电子版，也不是已经完成核验的知识库。它是一项公开迭代中的独立数字人文实践。</p>
    </div>
    <div class="hero-visual" aria-label="从纸本阅读到互动学习的制作过程">
      <header><small>一条内容怎样进入网站</small><span>制作记录 01</span></header>
      <ol>
        <li><b>纸本阅读</b><p>先确认章节边界，记下不理解的问题。</p></li>
        <li><b>知识拆分</b><p>把长章节拆成概念、证据和判断边界。</p></li>
        <li><b>互动转译</b><p>把“记住定义”改造成可以动手完成的任务。</p></li>
        <li><b>人工复核</b><p>回到纸本核对表述与页码，并公开记录进度。</p></li>
      </ol>
      <footer><span>当前纸本已核验</span><strong>{verifiedUnits} / {units.length}</strong><a href={`${base}audit/`}>查看审计记录 →</a></footer>
    </div>
  </section>

  <section class="flagship-entry container">
    <div class="flagship-mark"><span>综合</span><strong>案卷</strong></div>
    <div><p class="eyebrow">New flagship case</p><h2>你能否为一部“宋刻”残本写出谨慎的鉴定意见？</h2><p>跨越纸张、装帧、牌记、避讳、刻工、版式、目录和递藏记录。不是猜答案，而是给证据分配角色、限制结论强度并导出报告。</p></div>
    <a class="button" href={`${base}lab/#rare-book-dossier`}>打开古籍鉴定案卷 <span>→</span></a>
  </section>

  <section class="project-strip">
    <div class="container strip-inner">
      <p><span>当前阶段</span><strong>十四章结构化公测版</strong></p>
      <div class="strip-line"><span></span></div>
      <p><span>结构覆盖</span><strong>14 / 14 章已纳入</strong></p>
      <RepoPulse client:load />
      <a href={`${base}coverage/`}>查看覆盖矩阵 →</a>
    </div>
  </section>

  <section class="paths-section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">七条学习路径</p>
        <h2 class="section-title">七条路径，重建全书知识结构</h2>
      </div>
      <p>网站已经依据原书目录建立十四章覆盖框架；具体表述与精确页码仍按单元持续进行纸本复核。</p>
    </div>
    <div class="path-grid">
      {learningPaths.map((path) => (
        (() => { const review = pathReview.get(path.id)!; return (
        <a class="path-card" href={`${base}paths/${path.id}/`} style={`--accent:${path.color}`}>
          <div class="path-meta"><span>{path.number}</span><small>{path.chapters}</small></div>
          <h3>{path.title}</h3>
          <p>{path.subtitle}</p>
          <div class="path-progress"><span style={`width:${review.percent}%`}></span></div>
          <small>结构化覆盖 100% · 已核验 {review.verified}/{review.total} 单元</small>
        </a>
        ); })()
      ))}
    </div>
  </section>

  <section class="graph-preview">
    <div class="container graph-preview-grid">
      <div>
        <p class="eyebrow">知识关系</p>
        <h2 class="section-title">知识不是章节的队列，<br />而是彼此牵引的网络</h2>
        <p>点击概念，看它与载体、版本、方法、人物、典籍和时代发生怎样的关系。图谱将随阅读持续扩充。</p>
        <a class="text-link" href={`${base}graph/`}>探索知识图谱 →</a><a class="text-link lexicon-link" href={`${base}concepts/`}>浏览 176 个概念词条 →</a>
      </div>
      <div class="mini-graph" aria-hidden="true">
        <svg viewBox="0 0 520 330">
          <g class="lines">
            <path d="M260 165L98 85M260 165L415 75M260 165L430 225M260 165L125 245M98 85L180 50M415 75L480 145M125 245L260 275" />
          </g>
          <g class="dots">
            <circle cx="260" cy="165" r="35" />
            <circle cx="98" cy="85" r="24" />
            <circle cx="415" cy="75" r="24" />
            <circle cx="430" cy="225" r="24" />
            <circle cx="125" cy="245" r="24" />
            <circle cx="180" cy="50" r="15" />
            <circle cx="480" cy="145" r="15" />
            <circle cx="260" cy="275" r="15" />
          </g>
          <g class="labels">
            <text x="260" y="171">文献</text><text x="98" y="90">载体</text>
            <text x="415" y="80">版本</text><text x="430" y="230">校勘</text>
            <text x="125" y="250">目录</text><text x="180" y="55">纸</text>
            <text x="480" y="150">辨伪</text><text x="260" y="280">类书</text>
          </g>
        </svg>
      </div>
      <div class="graph-stats">
        {graphStats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
      </div>
    </div>
  </section>

  <section class="lab-preview container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">互动实验</p>
        <h2 class="section-title">综合案卷、六项旗舰实验与十五个章节案例</h2>
      </div>
      <a class="text-link" href={`${base}lab/`}>查看全部实验 →</a>
    </div>
    <div class="game-row">
      {games.slice(0, 4).map((game) => (
        <a class="game-card" href={`${base}lab/#${game.id}`}>
          <span class="game-icon">{game.icon}</span>
          <small>{game.chapters} · {game.status}</small>
          <h3>{game.title}</h3>
          <p>{game.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="author-note container">
    <div>
      <p class="eyebrow">作者手记</p>
      <h2>我没有等到“全部读懂”以后才开始</h2>
    </div>
    <blockquote>我希望边做边读：每遇到一个难以把握的概念，就追问它能否被画成关系、变成判断，或者设计成一次真正需要动手的练习。</blockquote>
    <div class="author-note__links"><a href={`${base}story/`}>阅读完整制作手记 →</a><a href={`${base}audit/`}>查看还没有完成的部分 →</a></div>
  </section>

  <section class="method-note container">
    <span class="method-number">01</span>
    <div>
      <p class="eyebrow">项目边界</p>
      <h2>帮助读者返回原书，而不代替原书</h2>
    </div>
    <p>网站只发布原创概括、评论、自制图表与互动案例；必要引文标明作者、版本和页码。原书电子文本与扫描材料不进入公开仓库。</p>
  </section>
</BaseLayout>

<style>
  .hero { min-height: 690px; display:grid; grid-template-columns: 1.08fr .92fr; align-items:center; gap:5rem; padding-block:6rem 4rem; }
  .hero h1{font-size:clamp(2.65rem,5vw,5.1rem);line-height:1.12}
  .hero-lead { max-width: 43rem; margin:2rem 0; color:var(--muted); font-family:var(--serif); font-size:1.08rem; line-height:2; }
  .hero-actions { display:flex; gap:.8rem; flex-wrap:wrap; }
  .hero-boundary{max-width:39rem;margin-top:1.35rem;padding-left:.8rem;border-left:2px solid var(--cinnabar);color:var(--muted);font-size:.75rem;line-height:1.7}
  .hero-visual{margin:auto;border:1px solid #baa993;background:#fffaf0;box-shadow:18px 18px 0 #e3d7c5;transform:rotate(1deg)}
  .hero-visual header,.hero-visual footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.2rem;border-bottom:1px solid var(--line)}
  .hero-visual header small{font-family:var(--serif);font-weight:700}.hero-visual header span{color:var(--cinnabar);font-size:.65rem;letter-spacing:.1em}
  .hero-visual ol{margin:0;padding:0 1.2rem;list-style:none;counter-reset:process}
  .hero-visual li{position:relative;display:grid;grid-template-columns:6.5rem 1fr;gap:1rem;padding:1rem 0 1rem 2.2rem;border-bottom:1px dashed var(--line);counter-increment:process}
  .hero-visual li::before{content:counter(process,decimal-leading-zero);position:absolute;left:0;color:var(--cinnabar);font-family:var(--serif)}
  .hero-visual li b{font-family:var(--serif)}.hero-visual li p{margin:0;color:var(--muted);font-size:.74rem;line-height:1.65}
  .hero-visual footer{border:0;background:#292a27;color:#f7f0e3}.hero-visual footer span{font-size:.68rem}.hero-visual footer strong{font-family:var(--serif);font-size:1.35rem}.hero-visual footer a{color:#d99781;font-size:.68rem;text-decoration:none}
  .project-strip { border-block:1px solid var(--line); background:rgba(255,253,247,.45); }
  .strip-inner { min-height:92px; display:grid; grid-template-columns:auto 1fr auto auto auto; align-items:center; gap:2rem; }
  .strip-inner p { display:flex; flex-direction:column; margin:0; }
  .strip-inner p span { color:var(--muted); font-size:.68rem; letter-spacing:.12em; }
  .strip-inner p strong { font-family:var(--serif); font-size:.92rem; }
  .strip-line { height:1px; background:var(--line); }.strip-line span{display:block;width:18%;height:2px;background:var(--cinnabar);}
  .strip-inner a,.text-link { color:var(--cinnabar); font-weight:600; text-decoration:none; }
  .paths-section,.lab-preview { padding-block:7rem; }
  .flagship-entry{display:grid;grid-template-columns:auto 1fr auto;gap:2rem;align-items:center;margin-top:5rem;padding:2rem;border:1px solid #5d5143;color:#f4ecdf;background:#292a27}.flagship-mark{display:grid;place-items:center;width:90px;aspect-ratio:1;border:2px solid #d99781;color:#d99781;transform:rotate(-3deg)}.flagship-mark span,.flagship-mark strong{display:block;font-family:var(--serif)}.flagship-mark span{font-size:.7rem;letter-spacing:.18em}.flagship-mark strong{font-size:1.5rem}.flagship-entry h2{margin:.2rem 0;font-family:var(--serif);font-size:1.6rem}.flagship-entry p:not(.eyebrow){margin:.4rem 0;color:#aaa59d;font-size:.82rem}.flagship-entry .button{white-space:nowrap}.lexicon-link{margin-left:1rem}
  .path-grid { display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid var(--line); border-left:1px solid var(--line); }
  .path-card { min-height:260px; padding:1.5rem; display:flex; flex-direction:column; border-right:1px solid var(--line); border-bottom:1px solid var(--line); text-decoration:none; background:rgba(255,253,247,.26); transition:.25s ease; }
  .path-card:hover { z-index:2; transform:translateY(-5px); background:var(--white); box-shadow:var(--shadow); }
  .path-card:nth-child(5){grid-column:span 2}.path-card:nth-child(6),.path-card:nth-child(7){grid-column:span 1}
  .path-meta { display:flex; justify-content:space-between; align-items:center; color:var(--muted); }.path-meta span{color:var(--accent);font-family:var(--serif);font-size:1.5rem;font-weight:700}
  .path-card h3 { margin:auto 0 .3rem; font-family:var(--serif); font-size:1.25rem; }.path-card p{min-height:3.4em;margin:.3rem 0 1rem;color:var(--muted);font-size:.9rem}
  .path-progress { height:3px; background:var(--line); }.path-progress span{display:block;height:100%;background:var(--accent)}
  .path-card > small { margin-top:.45rem;color:var(--muted);font-size:.68rem}
  .graph-preview { padding-block:7rem; color:#f7f0e3; background:#292a27; }
  .graph-preview-grid { display:grid; grid-template-columns:.72fr 1.28fr; gap:3rem; align-items:center; }
  .graph-preview .section-title { margin:.3rem 0 1.3rem; }.graph-preview p{color:#bbb6ac}.graph-preview .text-link{display:inline-block;margin-top:1rem;color:#d99781}
  .mini-graph svg{width:100%;overflow:visible}.lines path{fill:none;stroke:rgba(255,255,255,.18);stroke-width:1}.dots circle{fill:#8f352b;stroke:#d6b79c;stroke-width:.8}.dots circle:not(:first-child){fill:#3f5148}.labels text{fill:#fffaf0;font-family:var(--serif);font-size:11px;text-anchor:middle}
  .graph-stats { grid-column:1/-1; display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid rgba(255,255,255,.12); }
  .graph-stats div{padding:1.5rem 0;display:flex;gap:.7rem;align-items:baseline}.graph-stats strong{font-family:var(--serif);font-size:2rem}.graph-stats span{color:#aaa59d;font-size:.75rem}
  .game-row { display:grid; grid-template-columns:repeat(4,1fr); gap:1rem; }
  .game-card { min-height:290px; padding:1.4rem; display:flex; flex-direction:column; border:1px solid var(--line); border-radius:6px; text-decoration:none; background:rgba(255,253,247,.45); }
  .game-card:hover{background:var(--white);box-shadow:var(--shadow)}.game-icon{display:grid;place-items:center;width:55px;aspect-ratio:1;border-radius:50%;color:var(--cinnabar);background:#eaded0;font-family:var(--serif);font-size:1.35rem}.game-card small{margin-top:auto;color:var(--muted)}.game-card h3{margin:.5rem 0;font-family:var(--serif)}.game-card p{margin:0;color:var(--muted);font-size:.86rem}
  .method-note { margin-block:1rem 5rem; padding:3rem; display:grid; grid-template-columns:auto 1fr 1fr; align-items:center; gap:2.2rem; border:1px solid var(--line); background:#ebe1d1; }
  .author-note{display:grid;grid-template-columns:.8fr 1.4fr auto;gap:3rem;align-items:center;margin-block:2rem 5rem;padding:3rem 0;border-block:1px solid var(--line)}.author-note h2{margin:.25rem 0;font-family:var(--serif);font-size:2rem}.author-note blockquote{margin:0;color:var(--muted);font-family:var(--serif);font-size:1rem;line-height:1.9}.author-note__links{display:grid;gap:.5rem}.author-note__links a{color:var(--cinnabar);font-size:.76rem;white-space:nowrap}
  .method-number{font-family:var(--serif);font-size:3rem;color:var(--cinnabar)}.method-note h2{margin:0;font-family:var(--serif);font-size:1.5rem}.method-note p{margin:0;color:var(--muted)}
  @media(max-width:900px){.hero{grid-template-columns:1fr;padding-top:4rem}.hero-visual{width:min(540px,92vw)}.strip-inner{grid-template-columns:1fr 1fr}.strip-line{display:none}.flagship-entry{grid-template-columns:auto 1fr}.flagship-entry>a{grid-column:1/-1}.path-grid{grid-template-columns:repeat(2,1fr)}.path-card:nth-child(5){grid-column:span 1}.graph-preview-grid{grid-template-columns:1fr}.game-row{grid-template-columns:repeat(2,1fr)}.author-note{grid-template-columns:1fr 1fr}.author-note__links{grid-column:1/-1}.method-note{grid-template-columns:auto 1fr}.method-note>p{grid-column:1/-1}}
  @media(max-width:560px){.strip-inner,.path-grid,.game-row,.graph-stats,.flagship-entry,.author-note{grid-template-columns:1fr}.strip-inner{padding-block:1.2rem}.hero-visual{box-shadow:8px 8px 0 #e3d7c5}.hero-visual li{grid-template-columns:1fr}.hero-visual footer{align-items:flex-start;flex-direction:column}.flagship-entry{margin-top:3rem;padding:1.2rem}.flagship-entry>a{grid-column:auto}.path-card:nth-child(5){grid-column:auto}.section-heading{align-items:start}.method-note{padding:1.5rem}.lexicon-link{display:block;margin-left:0}}
</style>

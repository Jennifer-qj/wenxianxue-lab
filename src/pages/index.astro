---
import BaseLayout from "../layouts/BaseLayout.astro";
import RepoPulse from "../components/RepoPulse";
import { games, graphStats, learningPaths } from "../data/site";
import { getCollection } from "astro:content";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const outlineEntries = await getCollection("outline");
const units = outlineEntries.flatMap((entry) => entry.data.items);
const verifiedUnits = units.filter((unit) => unit.status === "verified").length;
const pathReview = new Map(learningPaths.map((path) => {
  const chapterNumbers = path.chapterIds.map((id) => Number(id.slice(2)));
  const pathUnits = units.filter((unit) => chapterNumbers.includes(unit.chapter));
  const verified = pathUnits.filter((unit) => unit.status === "verified").length;
  return [path.id, { total: pathUnits.length, verified, percent: pathUnits.length ? Math.round(verified / pathUnits.length * 100) : 0 }];
}));
---

<BaseLayout active="home">
  <section class="hero container">
    <div class="hero-copy">
      <p class="eyebrow">我的《文献学概要》读书现场 · 持续修订</p>
      <h1 class="display-title">把书边的问号，<em>搬进学习实验室</em></h1>
      <p class="hero-lead">
        读到卷子装、善本和校勘法时，我常在纸边画箭头，却很难把跨章线索留住。
        这个网站收纳的正是这些箭头：哪里要查概念，哪里要比较证据，哪里暂时不能下结论。
      </p>
      <div class="hero-actions">
        <a class="button" href={`${base}paths/`}>开始第一条学习路径 <span>→</span></a>
        <a class="button secondary" href={`${base}story/`}>先读我的制作手记</a>
      </div>
      <p class="hero-boundary">这里不替代原书，也不把尚未核对的草稿装成定论。它记录我怎样读、怎样拆、怎样改。</p>
    </div>
    <div class="hero-stage">
      <div class="hero-motion" aria-hidden="true">
        <svg viewBox="0 0 620 500" role="presentation">
          <path d="M55 122 C180 25 296 56 370 150 S525 264 584 163" />
          <path d="M70 382 C190 462 316 409 384 320 S514 248 590 340" />
          <path d="M150 80 C124 210 176 315 286 394" />
          <circle cx="55" cy="122" r="5" /><circle cx="370" cy="150" r="7" /><circle cx="584" cy="163" r="5" />
          <circle cx="70" cy="382" r="5" /><circle cx="384" cy="320" r="7" /><circle cx="590" cy="340" r="5" />
        </svg>
      </div>
      <div class="hero-fact hero-fact--chapters"><strong>14</strong><span>章知识结构</span></div>
      <div class="hero-fact hero-fact--concepts"><strong>176</strong><span>个概念节点</span></div>
      <div class="hero-visual" aria-label="从纸本阅读到互动学习的制作过程">
        <header><small>一条读书札记怎样变成网页</small><span><i></i> 制作进行中</span></header>
        <ol>
          <li><b>在书边提问</b><p>圈出术语、例证和读不通的地方。</p></li>
          <li><b>拆开长章节</b><p>分清概念、材料、证据和不能越过的边界。</p></li>
          <li><b>改成一次操作</b><p>让读者排序、称量、比较，而不只背一句定义。</p></li>
          <li><b>回书上逐条查</b><p>核对页码和表述，保留尚未解决的问题。</p></li>
        </ol>
        <footer><span>当前纸本已核验</span><strong>{verifiedUnits} / {units.length}</strong><a href={`${base}audit/`}>查看审计记录 →</a></footer>
      </div>
    </div>
  </section>

  <section class="flagship-entry container">
    <div class="flagship-mark"><span>综合</span><strong>案卷</strong></div>
    <div><p class="eyebrow">New flagship case</p><h2>旧题签写着“宋刻”，你会信到哪一步？</h2><p>纸张、装帧、牌记、避讳、刻工、版式、目录和递藏记录并不总说同一件事。先安排证据角色，再决定结论能写多满。</p></div>
    <a class="button" href={`${base}lab/#rare-book-dossier`}>打开古籍鉴定案卷 <span>→</span></a>
  </section>

  <section class="project-strip">
    <div class="container strip-inner">
      <p><span>当前阶段</span><strong>十四章结构化公测版</strong></p>
      <div class="strip-line"><span></span></div>
      <p><span>结构覆盖</span><strong>14 / 14 章已纳入</strong></p>
      <RepoPulse client:load />
      <a href={`${base}coverage/`}>查看覆盖矩阵 →</a>
    </div>
  </section>

  <section class="paths-section container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">七条学习路径</p>
        <h2 class="section-title">如果不按目录顺序读，可以从哪里进入？</h2>
      </div>
      <p>网站已经依据原书目录建立十四章覆盖框架；具体表述与精确页码仍按单元持续进行纸本复核。</p>
    </div>
    <div class="path-grid">
      {learningPaths.map((path) => (
        (() => { const review = pathReview.get(path.id)!; return (
        <a class="path-card" href={`${base}paths/${path.id}/`} style={`--accent:${path.color}`}>
          <div class="path-meta"><span>{path.number}</span><small>{path.chapters}</small></div>
          <h3>{path.title}</h3>
          <p>{path.subtitle}</p>
          <div class="path-progress"><span style={`width:${review.percent}%`}></span></div>
          <small>结构化覆盖 100% · 已核验 {review.verified}/{review.total} 单元</small>
        </a>
        ); })()
      ))}
    </div>
  </section>

  <section class="graph-preview">
    <div class="container graph-preview-grid">
      <div>
        <p class="eyebrow">知识关系</p>
        <h2 class="section-title">版本、校勘和目录，<br />为什么总会碰到一起？</h2>
        <p>点开一个概念，顺着连线查看它借用了哪类材料、通向哪种方法。每条关系都附有说明和置信度。</p>
        <a class="text-link" href={`${base}graph/`}>探索知识图谱 →</a><a class="text-link lexicon-link" href={`${base}concepts/`}>浏览 176 个概念词条 →</a>
      </div>
      <div class="mini-graph" aria-hidden="true">
        <svg viewBox="0 0 520 330">
          <g class="lines">
            <path d="M260 165L98 85M260 165L415 75M260 165L430 225M260 165L125 245M98 85L180 50M415 75L480 145M125 245L260 275" />
          </g>
          <g class="dots">
            <circle cx="260" cy="165" r="35" />
            <circle cx="98" cy="85" r="24" />
            <circle cx="415" cy="75" r="24" />
            <circle cx="430" cy="225" r="24" />
            <circle cx="125" cy="245" r="24" />
            <circle cx="180" cy="50" r="15" />
            <circle cx="480" cy="145" r="15" />
            <circle cx="260" cy="275" r="15" />
          </g>
          <g class="labels">
            <text x="260" y="171">文献</text><text x="98" y="90">载体</text>
            <text x="415" y="80">版本</text><text x="430" y="230">校勘</text>
            <text x="125" y="250">目录</text><text x="180" y="55">纸</text>
            <text x="480" y="150">辨伪</text><text x="260" y="280">类书</text>
          </g>
        </svg>
      </div>
      <div class="graph-stats">
        {graphStats.map((stat) => <div><strong>{stat.value}</strong><span>{stat.label}</span></div>)}
      </div>
    </div>
  </section>

  <section class="lab-preview container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">互动实验</p>
        <h2 class="section-title">综合案卷、七项旗舰实验与十五个章节案例</h2>
      </div>
      <a class="text-link" href={`${base}lab/`}>查看全部实验 →</a>
    </div>
    <div class="game-row">
      {games.slice(0, 4).map((game) => (
        <a class="game-card" href={`${base}lab/#${game.id}`}>
          <span class="game-icon">{game.icon}</span>
          <small>{game.chapters} · {game.status}</small>
          <h3>{game.title}</h3>
          <p>{game.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="author-note container">
    <div>
      <p class="eyebrow">作者手记</p>
      <h2>我没有等到“全部读懂”以后才开始</h2>
    </div>
    <blockquote>我希望边做边读：遇到一个难以把握的概念，就试着画出它和别章的关系，再把它改成一次排序、比较或证据判断。</blockquote>
    <div class="author-note__links"><a href={`${base}story/`}>阅读完整制作手记 →</a><a href={`${base}showcase/`}>打开三分钟项目展示 →</a><a href={`${base}audit/`}>查看还没有完成的部分 →</a></div>
  </section>

  <section class="method-note container">
    <span class="method-number">01</span>
    <div>
      <p class="eyebrow">项目边界</p>
      <h2>帮助读者返回原书，而不代替原书</h2>
    </div>
    <p>网站只发布原创概括、评论、自制图表与互动案例；必要引文标明作者、版本和页码。原书电子文本与扫描材料不进入公开仓库。</p>
  </section>
</BaseLayout>

<style>
  .hero { min-height: 620px; display:grid; grid-template-columns: 1.08fr .92fr; align-items:center; gap:clamp(3rem,6vw,6rem); padding-block:5rem 4rem; }
  .hero h1{font-size:clamp(2.7rem,4.7vw,4.65rem);line-height:1.17;text-wrap:balance}
  .hero-lead { max-width: 40rem; margin:1.7rem 0; color:var(--muted); font-family:var(--serif); font-size:1.04rem; line-height:1.95; }
  .hero-actions { display:flex; gap:.8rem; flex-wrap:wrap; }
  .hero-boundary{max-width:39rem;margin-top:1.35rem;padding-left:.8rem;border-left:2px solid color-mix(in srgb,var(--cinnabar) 60%,transparent);color:var(--muted);font-size:.75rem;line-height:1.7}
  .hero-visual{position:relative;margin:auto;border:1px solid var(--line);border-radius:12px;background:color-mix(in srgb,var(--white) 90%,transparent);box-shadow:var(--shadow)}
  .hero-visual::before{content:"";position:absolute;inset:8px;border:1px solid rgba(163,59,43,.08);border-radius:7px;pointer-events:none}
  .hero-visual header,.hero-visual footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.2rem;border-bottom:1px solid var(--line)}
  .hero-visual header small{font-family:var(--serif);font-weight:700}.hero-visual header span{color:var(--cinnabar);font-size:.65rem;letter-spacing:.1em}
  .hero-visual ol{margin:0;padding:0 1.2rem;list-style:none;counter-reset:process}
  .hero-visual li{position:relative;display:grid;grid-template-columns:6.5rem 1fr;gap:1rem;padding:1rem 0 1rem 2.2rem;border-bottom:1px solid var(--line);counter-increment:process}
  .hero-visual li::before{content:counter(process,decimal-leading-zero);position:absolute;left:0;color:var(--cinnabar);font-family:var(--serif)}
  .hero-visual li b{font-family:var(--serif)}.hero-visual li p{margin:0;color:var(--muted);font-size:.74rem;line-height:1.65}
  .hero-visual footer{border:0;border-radius:0 0 11px 11px;background:#24302b;color:#f7f0e3}.hero-visual footer span{font-size:.68rem}.hero-visual footer strong{font-family:var(--serif);font-size:1.35rem}.hero-visual footer a{color:#e7b39d;font-size:.68rem;text-decoration:none}
  .project-strip { border-block:1px solid var(--line); background:rgba(255,253,247,.45); }
  .strip-inner { min-height:92px; display:grid; grid-template-columns:auto 1fr auto auto auto; align-items:center; gap:2rem; }
  .strip-inner p { display:flex; flex-direction:column; margin:0; }
  .strip-inner p span { color:var(--muted); font-size:.68rem; letter-spacing:.12em; }
  .strip-inner p strong { font-family:var(--serif); font-size:.92rem; }
  .strip-line { height:1px; background:var(--line); }.strip-line span{display:block;width:18%;height:2px;background:var(--cinnabar);}
  .strip-inner a,.text-link { color:var(--cinnabar); font-weight:600; text-decoration:none; }
  .paths-section,.lab-preview { padding-block:6rem; }
  .flagship-entry{display:grid;grid-template-columns:auto 1fr auto;gap:2rem;align-items:center;margin-top:4rem;padding:2rem;border:1px solid rgba(255,255,255,.1);border-radius:14px;color:#f4ecdf;background:#24302b;box-shadow:var(--shadow)}.flagship-mark{display:grid;place-items:center;width:82px;aspect-ratio:1;border:1px solid #d99781;border-radius:50%;color:#e2a78e}.flagship-mark span,.flagship-mark strong{display:block;font-family:var(--serif)}.flagship-mark span{font-size:.65rem;letter-spacing:.16em}.flagship-mark strong{font-size:1.4rem}.flagship-entry h2{margin:.2rem 0;font-family:var(--serif);font-size:1.55rem}.flagship-entry p:not(.eyebrow){margin:.4rem 0;color:#b8b8ae;font-size:.82rem}.flagship-entry .button{white-space:nowrap;background:#f2eee5;color:#24302b;border-color:#f2eee5}.lexicon-link{margin-left:1rem}
  .path-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1rem; }
  .path-card { min-height:240px; padding:1.5rem; display:flex; flex-direction:column; border:1px solid var(--line); border-radius:10px; text-decoration:none; background:rgba(252,251,247,.58); transition:.25s ease; }
  .path-card:hover { z-index:2; transform:translateY(-4px); border-color:color-mix(in srgb,var(--accent) 45%,var(--line)); background:var(--white); box-shadow:var(--shadow-soft); }
  .path-card:nth-child(5),.path-card:nth-child(6),.path-card:nth-child(7){grid-column:auto}.path-card:nth-child(7){grid-column:span 3;min-height:190px}
  .path-meta { display:flex; justify-content:space-between; align-items:center; color:var(--muted); }.path-meta span{color:var(--accent);font-family:var(--serif);font-size:1.5rem;font-weight:700}
  .path-card h3 { margin:auto 0 .3rem; font-family:var(--serif); font-size:1.25rem; }.path-card p{min-height:3.4em;margin:.3rem 0 1rem;color:var(--muted);font-size:.9rem}
  .path-progress { height:3px; background:var(--line); }.path-progress span{display:block;height:100%;background:var(--accent)}
  .path-card > small { margin-top:.45rem;color:var(--muted);font-size:.68rem}
  .graph-preview { padding-block:6rem; color:#f7f0e3; background:#24302b; }
  .graph-preview-grid { display:grid; grid-template-columns:.72fr 1.28fr; gap:3rem; align-items:center; }
  .graph-preview .section-title { margin:.3rem 0 1.3rem; }.graph-preview p{color:#bbb6ac}.graph-preview .text-link{display:inline-block;margin-top:1rem;color:#d99781}
  .mini-graph svg{width:100%;overflow:visible}.lines path{fill:none;stroke:rgba(255,255,255,.18);stroke-width:1}.dots circle{fill:#8f352b;stroke:#d6b79c;stroke-width:.8}.dots circle:not(:first-child){fill:#3f5148}.labels text{fill:#fffaf0;font-family:var(--serif);font-size:11px;text-anchor:middle}
  .graph-stats { grid-column:1/-1; display:grid; grid-template-columns:repeat(4,1fr); border-top:1px solid rgba(255,255,255,.12); }
  .graph-stats div{padding:1.5rem 0;display:flex;gap:.7rem;align-items:baseline}.graph-stats strong{font-family:var(--serif);font-size:2rem}.graph-stats span{color:#aaa59d;font-size:.75rem}
  .game-row { display:grid; grid-template-columns:repeat(2,1fr); gap:1rem; }
  .game-card { min-height:220px; padding:1.5rem; display:grid;grid-template-columns:auto 1fr;grid-template-rows:auto 1fr auto;gap:.1rem 1rem; border:1px solid var(--line); border-radius:10px; text-decoration:none; background:rgba(252,251,247,.58); }
  .game-card:hover{transform:translateY(-3px);border-color:rgba(163,59,43,.28);background:var(--white);box-shadow:var(--shadow-soft)}.game-icon{grid-row:1/3;display:grid;place-items:center;width:52px;aspect-ratio:1;border-radius:50%;color:var(--cinnabar);background:#ede1d6;font-family:var(--serif);font-size:1.25rem}.game-card small{grid-column:2;margin-top:auto;color:var(--muted)}.game-card h3{margin:.2rem 0;font-family:var(--serif);font-size:1.25rem}.game-card p{margin:0;color:var(--muted);font-size:.86rem}
  .method-note { margin-block:1rem 5rem; padding:2.5rem; display:grid; grid-template-columns:auto 1fr 1fr; align-items:center; gap:2.2rem; border:1px solid var(--line); border-radius:12px; background:#ebe5da; }
  .author-note{display:grid;grid-template-columns:.8fr 1.4fr auto;gap:3rem;align-items:center;margin-block:2rem 5rem;padding:3rem 0;border-block:1px solid var(--line)}.author-note h2{margin:.25rem 0;font-family:var(--serif);font-size:2rem}.author-note blockquote{margin:0;color:var(--muted);font-family:var(--serif);font-size:1rem;line-height:1.9}.author-note__links{display:grid;gap:.5rem}.author-note__links a{color:var(--cinnabar);font-size:.76rem;white-space:nowrap}
  .method-number{font-family:var(--serif);font-size:3rem;color:var(--cinnabar)}.method-note h2{margin:0;font-family:var(--serif);font-size:1.5rem}.method-note p{margin:0;color:var(--muted)}
  @media(max-width:900px){.hero{grid-template-columns:1fr;padding-top:4rem}.hero-visual{width:min(540px,92vw)}.strip-inner{grid-template-columns:1fr 1fr}.strip-line{display:none}.flagship-entry{grid-template-columns:auto 1fr}.flagship-entry>a{grid-column:1/-1}.path-grid{grid-template-columns:repeat(2,1fr)}.path-card:nth-child(7){grid-column:span 2}.graph-preview-grid{grid-template-columns:1fr}.game-row{grid-template-columns:repeat(2,1fr)}.author-note{grid-template-columns:1fr 1fr}.author-note__links{grid-column:1/-1}.method-note{grid-template-columns:auto 1fr}.method-note>p{grid-column:1/-1}}
  @media(max-width:560px){.strip-inner,.path-grid,.game-row,.graph-stats,.flagship-entry,.author-note{grid-template-columns:1fr}.strip-inner{padding-block:1.2rem}.hero h1 br{display:none}.hero-visual li{grid-template-columns:1fr}.hero-visual footer{align-items:flex-start;flex-direction:column}.flagship-entry{margin-top:3rem;padding:1.2rem}.flagship-entry>a{grid-column:auto}.path-card:nth-child(7){grid-column:auto}.section-heading{align-items:start}.game-card{grid-template-columns:auto 1fr;min-height:210px}.method-note{padding:1.5rem}.lexicon-link{display:block;margin-left:0}}
  /* second-pass hero: use the empty upper-right area as an animated knowledge field */
  .hero{grid-template-columns:minmax(0,1.04fr) minmax(480px,.96fr);align-items:start;min-height:660px;padding-top:5.5rem}
  .hero-copy{padding-top:1.8rem}
  .hero-stage{position:relative;isolation:isolate;min-height:610px;display:grid;align-items:start;padding:3.2rem 2.2rem 2rem}
  .hero-motion{position:absolute;inset:-1.5rem -2rem 0 -3rem;z-index:0;opacity:.62;pointer-events:none}
  .hero-motion svg{width:100%;height:100%;overflow:visible}
  .hero-motion path{fill:none;stroke:rgba(82,106,85,.22);stroke-width:1;stroke-dasharray:5 8;animation:knowledge-flow 18s linear infinite}
  .hero-motion circle{fill:#f6f3ec;stroke:rgba(163,59,43,.55);stroke-width:2;transform-box:fill-box;transform-origin:center;animation:node-breathe 3.6s ease-in-out infinite}
  .hero-motion circle:nth-of-type(2),.hero-motion circle:nth-of-type(5){fill:#a33b2b;stroke:#a33b2b;animation-delay:-1.4s}
  .hero-motion circle:nth-of-type(3),.hero-motion circle:nth-of-type(6){animation-delay:-2.3s}
  .hero-fact{position:absolute;z-index:2;display:flex;align-items:baseline;gap:.45rem;padding:.55rem .8rem;border:1px solid var(--line);border-radius:999px;background:rgba(252,251,247,.9);box-shadow:var(--shadow-soft);backdrop-filter:blur(8px)}
  .hero-fact strong{color:var(--cinnabar);font-family:var(--serif);font-size:1.2rem}.hero-fact span{color:var(--muted);font-size:.67rem}
  .hero-fact--chapters{top:0;right:4.5rem}.hero-fact--concepts{right:-.2rem;bottom:5.8rem}
  .hero-visual{z-index:1;width:100%;margin:0;align-self:start;box-shadow:0 24px 65px rgba(36,42,37,.12)}
  .hero-visual header span{display:flex;align-items:center;gap:.35rem}.hero-visual header span i{display:block;width:6px;aspect-ratio:1;border-radius:50%;background:var(--cinnabar);box-shadow:0 0 0 0 rgba(163,59,43,.35);animation:live-pulse 2s ease-out infinite}
  .hero-visual li{transition:background .35s ease}
  .hero-visual li::after{content:"";position:absolute;left:-1.2rem;top:50%;width:3px;height:0;border-radius:3px;background:var(--cinnabar);transform:translateY(-50%);opacity:0}
  .hero-visual li:nth-child(1){animation:step-focus 8s ease-in-out infinite}
  .hero-visual li:nth-child(2){animation:step-focus 8s 2s ease-in-out infinite}
  .hero-visual li:nth-child(3){animation:step-focus 8s 4s ease-in-out infinite}
  .hero-visual li:nth-child(4){animation:step-focus 8s 6s ease-in-out infinite}
  @keyframes knowledge-flow{to{stroke-dashoffset:-130}}
  @keyframes node-breathe{0%,100%{transform:scale(1);opacity:.55}50%{transform:scale(1.45);opacity:1}}

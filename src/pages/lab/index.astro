---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VersionDetective from "../../components/VersionDetective";
import FourFoldChallenge from "../../components/FourFoldChallenge";
import SkillArcade from "../../components/SkillArcade";
import CaseGallery from "../../components/CaseGallery";
import RareBookDossier from "../../components/RareBookDossier";
import EvidenceCalibrationLab from "../../components/EvidenceCalibrationLab";
import TextualCriticismStudio from "../../components/TextualCriticismStudio";
import { getCollection } from "astro:content";
import { games } from "../../data/site";

const [labEntries, conceptEntries] = await Promise.all([getCollection("labs"), getCollection("concepts")]);
const allConcepts = conceptEntries.flatMap((entry) => entry.data.items);
const labCases = labEntries.flatMap((entry) => entry.data.items.map((lab) => ({ ...lab, chapter: Number(entry.id.slice(2)), concepts: lab.concept_ids.flatMap((id) => { const concept = allConcepts.find((item) => item.id === id); return concept ? [{ id: concept.id, label: concept.label }] : []; }) })));
const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
---

<BaseLayout title="互动实验室" active="lab">
  <header class="page-hero container">
    <p class="eyebrow">Interactive laboratory · 动手以后再回书上</p>
    <h1 class="display-title">先别背定义，<em>来处理一份材料</em></h1>
    <p>我把读书时最容易糊弄过去的几个瞬间留在这里：纸黄是不是就够老？序跋有纪年是不是就能定版？底本不同的时候，哪个字才该进正文？先动手，再带着自己的错误回到章节。</p>
  </header>

  <section id="rare-book-dossier" class="dossier-section">
    <div class="container">
      <div class="section-heading dossier-heading"><div><p class="eyebrow">Flagship case</p><h2 class="section-title">古籍鉴定综合案卷</h2></div><p>跨越载体、装帧、牌记、避讳、刻工、版式、目录和递藏证据。所有材料均为教学虚构，方法逻辑来自全书结构化知识。</p></div>
      <RareBookDossier baseUrl={base} client:load />
    </div>
  </section>

  <section id="version-detective" class="featured-game">
    <div class="container featured-grid">
      <div class="game-intro">
        <span class="chapter-tag">第五章 · 文献的版本</span>
        <h2>版本鉴定侦探</h2>
        <p>面对一部无名刻本，先封存直觉，再分三批查看六条线索。你需要给证据分配角色、写出理由、校准信心，并保留一份可以撤回和导出的研判轨迹。</p>
        <dl>
          <div><dt>学习目标</dt><dd>区分线索、证据与结论</dd></div>
          <div><dt>操作机制</dt><dd>假说＋揭证＋分级＋报告</dd></div>
          <div><dt>预计用时</dt><dd>8 分钟</dd></div>
          <div><dt>进度保存</dt><dd>当前浏览器</dd></div>
        </dl>
      </div>
      <VersionDetective client:load />
    </div>
  </section>

  <section id="four-fold" class="fourfold-section">
    <div class="container fourfold-grid">
      <div class="fourfold-copy">
        <span class="chapter-tag">第七章 · 文献目录</span>
        <h2>四部分类挑战</h2>
        <p>把八部典籍从书车拖进经、史、子、集四个书架。全部归架后统一核验，观察每本书的内容、体例与传统著录位置。</p>
        <div class="learning-loop"><span>观察体例</span><i>→</i><span>批量归架</span><i>→</i><span>修正边界</span></div>
      </div>
      <FourFoldChallenge client:load />
    </div>
  </section>

  <section id="evidence-calibration" class="calibration-section">
    <div class="container">
      <div class="section-heading calibration-heading"><div><p class="eyebrow">Evidence calibration</p><h2 class="section-title">证据称量室</h2></div><p>不是选择“正确答案”，而是亲手给证据分配强度、写出有限度结论，再比较推理跨度。四份案卷横跨版本、校勘、辨伪和敦煌残卷。</p></div>
      <EvidenceCalibrationLab client:load />
    </div>
  </section>

  <section id="criticism-studio" class="criticism-studio-section">
    <div class="container">
      <div class="section-heading criticism-heading"><div><p class="eyebrow">Textual criticism studio</p><h2 class="section-title">从辨认差异，走到写出可复查的判断</h2></div><p>两项进阶实验不要求猜一个选项：你需要给材料分配证据角色、写校勘记，或亲手连接版本亲缘并说明模型的限制。</p></div>
      <TextualCriticismStudio client:load />
    </div>
  </section>

  <section class="arcade-section">
    <div class="container">
      <div class="section-heading arcade-heading">
        <div><p class="eyebrow">Skill arcade</p><h2 class="section-title">四种可调整的操作台</h2></div>
        <p>校勘流程重排、载体线索配对、装帧序列重建与工具书批量分拣，分别训练程序意识、物质识别、序列建构和分类判断。</p>
      </div>
      <SkillArcade client:load />
    </div>
  </section>

  <section id="case-gallery" class="case-gallery-section">
    <div class="container">
      <div class="section-heading case-gallery-heading">
        <div><p class="eyebrow">Chapter case files</p><h2 class="section-title">每一章都有一个可操作现场</h2></div>
        <p>把结构化内容转成十五个小型案例：有的要求追踪证据，有的要求重排流程、标注文本或比较传播方案。完成后会写入本地学习档案。</p>
      </div>
      <CaseGallery labs={labCases} baseUrl={base} client:load />
    </div>
  </section>

  <section class="all-games container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The full collection</p>
        <h2 class="section-title">九项旗舰实验</h2>
      </div>
      <p>这里只展示已经可以完整操作并获得反馈的实验，不以路线图或占位卡代替交付。</p>
    </div>
    <div class="game-grid">
      {games.map((game, index) => (
        <article id={game.id} class:list={{ ready: game.status === "可体验" }}>
          <div class="game-top"><span>{game.icon}</span><small>{String(index + 1).padStart(2, "0")}</small></div>
          <small>{game.chapters}</small>
          <h3>{game.title}</h3>
          <p>{game.description}</p>
          <b class="live">{game.status}</b>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero{padding:7rem 0 5rem}.page-hero>p:last-child{max-width:46rem;color:var(--muted);font-family:var(--serif)}
  .featured-game{padding:5rem 0;background:#2b2c29;color:#f9f2e6}.featured-grid{display:grid;grid-template-columns:.65fr 1.35fr;gap:4rem;align-items:center}
  .dossier-section{padding:7rem 0;background:#d8c9b2}.dossier-heading>p{max-width:38rem;color:var(--muted)}
  .game-intro h2{margin:1rem 0;font-family:var(--serif);font-size:2.4rem}.game-intro>p{color:#bbb6ad}.chapter-tag{color:#d89882;font-size:.72rem;letter-spacing:.12em}.game-intro dl{margin-top:2rem;border-top:1px solid rgba(255,255,255,.13)}.game-intro dl div{display:flex;justify-content:space-between;padding:.65rem 0;border-bottom:1px solid rgba(255,255,255,.13)}dt{color:#99958d}dd{margin:0}

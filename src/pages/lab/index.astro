  .case-gallery-section{padding:7rem 0;background:#e9dfcf}.case-gallery-heading{margin-bottom:2rem}.case-gallery-heading>p{max-width:34rem;color:var(--muted)}
  .criticism-studio-section{padding:7rem 0;color:#f8f1e6;background:#29362f}.criticism-heading>p{max-width:39rem;color:#b9beb9}
  :global(.skill-arcade){overflow:hidden;border:1px solid rgba(255,255,255,.13);border-radius:8px;background:#f6f0e4}

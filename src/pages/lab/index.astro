  :global(.evidence-desk){min-height:760px}:global(.desk-instruction){color:var(--muted);font-size:.82rem}:global(.evidence-pool){min-height:130px;padding:1rem;border:1px dashed #aa9a82;background:rgba(255,255,255,.35)}:global(.evidence-pool>small){color:var(--muted)}:global(.evidence-pool>div),:global(.evidence-bins section>div){display:flex;flex-wrap:wrap;gap:.5rem;margin-top:.5rem}:global(.evidence-bins){display:grid;grid-template-columns:repeat(3,1fr);gap:.6rem;margin-top:.8rem}:global(.evidence-bins>section){min-height:210px;padding:.8rem;border:1px solid #cbbba2;background:#e9decd}:global(.evidence-bins>section.accepting){outline:2px dashed #c9825c;outline-offset:-5px}:global(.evidence-bins header strong),:global(.evidence-bins header small){display:block}:global(.evidence-bins header small){color:var(--muted);font-size:.66rem}:global(.evidence-card){width:100%;padding:.6rem;text-align:left;border:1px solid #cbbba2;border-radius:3px;background:#fffaf0;color:var(--ink);font:inherit;cursor:grab}:global(.evidence-card strong),:global(.evidence-card span),:global(.evidence-card small){display:block}:global(.evidence-card span){color:var(--muted);font-size:.75rem}:global(.evidence-card small){margin-top:.45rem;color:#6e5143}:global(.desk-submit){display:block;margin:1rem 0 0 auto}:global(.verdict-builder){margin-top:1rem;padding-top:1rem;border-top:1px solid var(--line)}:global(.verdict-builder h3){font-family:var(--serif)}:global(.evidence-score){display:flex;justify-content:space-between;gap:1rem;padding:.7rem;background:#f2dfda}:global(.evidence-score.success){background:#e3eee3}:global(.evidence-score span){color:var(--muted);font-size:.75rem}:global(.verdict-options){display:grid;gap:.5rem}:global(.verdict-options button){display:grid;grid-template-columns:28px 1fr;gap:.6rem;align-items:center;padding:.7rem;text-align:left;border:1px solid var(--line);background:#fffaf0;cursor:pointer}:global(.verdict-options button>span){display:grid;place-items:center;width:
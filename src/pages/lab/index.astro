  :global(.confidence-control){display:grid;grid-template-columns:1fr auto;gap:.7rem 1rem;align-items:center;margin:1rem 0;padding:.9rem;border:1px solid var(--line);background:#ede4d7}:global(.confidence-control span b),:global(.confidence-control span small){display:block}:global(.confidence-control span small){color:var(--muted);font-size:.68rem}:global(.confidence-control output){color:var(--cinnabar);font-family:var(--serif);font-size:1.5rem}:global(.confidence-control input){grid-column:1/-1;width:100%;accent-color:var(--cinnabar)}:global(.hypothesis-strip){display:grid;grid-template-columns:auto 1fr auto;gap:.8rem;align-items:center;margin-bottom:1rem;padding:.7rem .9rem;color:#f5eee3;background:#33483e}:global(.hypothesis-strip span){color:#b7c2bc;font-size:.65rem}:global(.hypothesis-strip strong){font-family:var(--serif)}:global(.hypothesis-strip b){color:#efb79f}:global(.evidence-reveal){display:flex;align-items:center;gap:.8rem;margin:.8rem 0;padding:.55rem .7rem;border:1px solid var(--line);background:#f3ecdf}:global(.evidence-reveal>span){font-size:.7rem}:global(.evidence-reveal>div){display:flex;flex:1;gap:.3rem}:global(.evidence-reveal i){width:34px;height:4px;background:#d2c5b4}:global(.evidence-reveal i.open){background:var(--cinnabar)}:global(.evidence-reveal button){padding:.4rem .6rem;border:1px solid var(--cinnabar);color:var(--cinnabar);background:transparent;font:inherit;font-size:.68rem;cursor:pointer}:global(.evidence-card em){display:block;margin-top:.45rem;color:#6e5143;font-size:.68rem;font-style:normal;line-height:1.5}:global(.classification-review){margin-top:1rem}:global(.classification-review>div:last-child),:global(.argument-actions),:global(.report-actions){display:flex;justify-content:flex-end;gap:.5rem;margin-top:.7rem}:global(.classification-review button),:global(.argument-actions button),:global(.report-actions button){padding:.55rem .75rem;border:1px solid var(--line);background:#fffaf0;color:var(--ink);font:inherit;font-size:
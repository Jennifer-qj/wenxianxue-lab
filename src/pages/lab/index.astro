---
import BaseLayout from "../../layouts/BaseLayout.astro";
import VersionDetective from "../../components/VersionDetective";
import { games } from "../../data/site";
---

<BaseLayout title="互动实验室" active="lab">
  <header class="page-hero container">
    <p class="eyebrow">Interactive laboratory</p>
    <h1 class="display-title">把定义放进<em>真实判断</em>里</h1>
    <p>每项实验都对应明确的学习目标。先观察、再选择、再阅读反馈，让错误也成为理解概念的一条路径。</p>
  </header>

  <section id="version-detective" class="featured-game">
    <div class="container featured-grid">
      <div class="game-intro">
        <span class="chapter-tag">第五章 · 文献的版本</span>
        <h2>版本鉴定侦探</h2>
        <p>面对一部无名刻本，你会相信哪一条线索？完成三轮证据判断，体验“多证据互证”与“结论留有边界”的版本学思维。</p>
        <dl>
          <div><dt>学习目标</dt><dd>区分线索、证据与结论</dd></div>
          <div><dt>预计用时</dt><dd>3 分钟</dd></div>
          <div><dt>进度保存</dt><dd>当前浏览器</dd></div>
        </dl>
      </div>
      <VersionDetective client:load />
    </div>
  </section>

  <section class="all-games container">
    <div class="section-heading">
      <div>
        <p class="eyebrow">The full collection</p>
        <h2 class="section-title">十二项实验路线图</h2>
      </div>
      <p>“制作中”表示已进入第一批开发；其余实验将在相应章节内容完成后开放，确保玩法建立在可靠内容上。</p>
    </div>
    <div class="game-grid">
      {games.map((game, index) => (
        <article id={game.id} class:list={{ ready: game.status === "可体验" }}>
          <div class="game-top"><span>{game.icon}</span><small>{String(index + 1).padStart(2, "0")}</small></div>
          <small>{game.chapters}</small>
          <h3>{game.title}</h3>
          <p>{game.description}</p>
          <b class:list={{ live: game.status === "可体验", building: game.status === "制作中" }}>{game.status}</b>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero{padding:7rem 0 5rem}.page-hero>p:last-child{max-width:46rem;color:var(--muted);font-family:var(--serif)}
  .featured-game{padding:5rem 0;background:#2b2c29;color:#f9f2e6}.featured-grid{display:grid;grid-template-columns:.65fr 1.35fr;gap:4rem;align-items:center}
  .game-intro h2{margin:1rem 0;font-family:var(--serif);font-size:2.4rem}.game-intro>p{color:#bbb6ad}.chapter-tag{color:#d89882;font-size:.72rem;letter-spacing:.12em}.game-intro dl{margin-top:2rem;border-top:1px solid rgba(255,255,255,.13)}.game-intro dl div{display:flex;justify-content:space-between;padding:.65rem 0;border-bottom:1px solid rgba(255,255,255,.13)}dt{color:#99958d}dd{margin:0}
  .all-games{padding-block:7rem}.game-grid{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-left:1px solid var(--line)}
  .game-grid article{min-height:280px;padding:1.4rem;display:flex;flex-direction:column;border-right:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(255,253,247,.25)}.game-grid article.ready{background:#fffaf0}
  .game-top{display:flex;justify-content:space-between;align-items:center}.game-top>span{display:grid;place-items:center;width:50px;aspect-ratio:1;border-radius:50%;color:var(--cinnabar);background:#eaded0;font-family:var(--serif);font-size:1.2rem}.game-top small,.game-grid article>small{color:var(--muted)}.game-grid article>small{margin-top:auto}.game-grid h3{margin:.4rem 0;font-family:var(--serif);font-size:1.18rem}.game-grid p{margin:0;color:var(--muted);font-size:.86rem}.game-grid b{width:max-content;margin-top:1rem;padding:.15rem .5rem;border-radius:999px;color:var(--muted);background:#e2dbcf;font-size:.68rem}.game-grid b.live{color:#47644e;background:#dce8dc}.game-grid b.building{color:#7a5b2d;background:#eee1c5}
  @media(max-width:860px){.featured-grid{grid-template-columns:1fr}.game-grid{grid-template-columns:repeat(2,1fr)}}
  @media(max-width:560px){.game-grid{grid-template-columns:1fr}}
</style>

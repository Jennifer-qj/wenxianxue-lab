---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { learningPaths } from "../../data/site";
---

<BaseLayout title="学习路径" active="paths">
  <header class="page-hero container">
    <p class="eyebrow">Learning paths</p>
    <h1 class="display-title">从全书目录，走向<em>问题地图</em></h1>
    <p>七条学习路径不是对十四章的删减，而是重新安排进入知识的顺序。每条路径都能反向追溯到原书章节与页码。</p>
  </header>
  <section class="path-list container">
    {learningPaths.map((path) => (
      <article id={path.id} style={`--accent:${path.color}`}>
        <span class="number">{path.number}</span>
        <div>
          <small>{path.chapters}</small>
          <h2>{path.title}</h2>
          <p>{path.subtitle}</p>
        </div>
        <div class="status">
          <span><i style={`width:${path.progress}%`}></i></span>
          <small>整理进度 {path.progress}%</small>
        </div>
        <button disabled title="内容整理完成后开放">进入路径 →</button>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .page-hero{padding:7rem 0 4rem}.page-hero p:last-child{max-width:45rem;color:var(--muted);font-family:var(--serif);font-size:1.05rem}
  .path-list{padding-bottom:6rem;border-top:1px solid var(--line)}
  article{min-height:155px;display:grid;grid-template-columns:90px 1.4fr 1fr auto;align-items:center;gap:2rem;border-bottom:1px solid var(--line)}
  .number{color:var(--accent);font-family:var(--serif);font-size:2rem;font-weight:700}article small{color:var(--muted)}h2{margin:.2rem 0;font-family:var(--serif);font-size:1.45rem}article p{margin:0;color:var(--muted)}
  .status>span{display:block;width:100%;height:3px;background:var(--line)}.status i{display:block;height:100%;background:var(--accent)}.status small{font-size:.7rem}
  button{padding:.65rem 1rem;border:1px solid var(--line);background:transparent;color:var(--muted);font:inherit}
  @media(max-width:760px){article{grid-template-columns:50px 1fr;padding:1.5rem 0}.status,button{grid-column:2}}
</style>

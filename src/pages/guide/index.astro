---
import BaseLayout from "../../layouts/BaseLayout.astro";

const base = `${import.meta.env.BASE_URL.replace(/\/$/, "")}/`;
const steps = [
  { n: "01", title: "选一条入口", text: "第一次学习走入门路径；带着问题来用搜索和概念词典；想动手则直接进入实验室。", href: `${base}?welcome=1`, action: "重新打开入口选择" },
  { n: "02", title: "选择一章的读法", text: "进入章节后先选速览、标准或深研模式，再沿六步学习地图阅读；不要求一次做完。", href: `${base}chapters/ch01/#journey`, action: "从第一章试读" },
  { n: "03", title: "把概念连起来", text: "在知识图谱选择起点和终点，查看概念之间最短的知识路径，再进入词条细读。", href: `${base}graph/`, action: "打开知识图谱" },
  { n: "04", title: "完成一次判断", text: "在互动实验室做分类、排序、校勘或古籍鉴定案卷，把定义转化为判断过程。", href: `${base}lab/`, action: "进入互动实验室" },
  { n: "05", title: "留下自己的札记", text: "点击页面右下角“学习札记”，收藏当前页面并记录判断、疑问或待核对事项。", href: `${base}notebook/`, action: "打开个人工作台" },
  { n: "06", title: "收束、回看与备份", text: "进度页会把章节任务和复盘整理成个人成果册，同时给出到期错题、下一步推荐和完整档案备份。", href: `${base}progress/#portfolio`, action: "查看个人成果册" },
];
---

<BaseLayout title="使用指南" description="文献学实验室的快速入门、功能说明、学习方法与常见问题" active="guide">
  <header class="guide-hero">
    <div class="container"><p class="eyebrow">USER GUIDE · 使用指南</p><h1 class="display-title">不要先把所有页面看完，<em>先完成一次学习循环</em></h1><p>读懂一个问题，做一次判断，查看反馈，再回到证据。下面这条路线大约十分钟，可以让你理解网站的全部核心机制。</p><div><a href="#quickstart">开始十分钟体验 ↓</a><a href={`${base}?welcome=1`}>重新打开新手引导</a></div></div>
  </header>

  <div class="guide-main container">
    <aside class="guide-toc"><small>本页目录</small><a href="#quickstart">十分钟入门</a><a href="#map">功能地图</a><a href="#records">记录与隐私</a><a href="#reading">怎样使用内容</a><a href="#faq">常见问题</a></aside>
    <article>
      <section id="quickstart"><p class="eyebrow">01 · Quick start</p><h2>十分钟入门路线</h2><div class="quick-steps">{steps.map((step) => <article><span>{step.n}</span><div><h3>{step.title}</h3><p>{step.text}</p><a href={step.href}>{step.action} →</a></div></article>)}</div></section>

      <section id="map"><p class="eyebrow">02 · Feature map</p><h2>每个功能解决什么问题？</h2><div class="feature-manual">
        <article><small>学习路径</small><h3>不知道从哪里开始</h3><p>七条路径按学习目的重排十四章，不要求机械依照原书章节顺序。</p><ol><li>选择一个目标</li><li>按路径进入相关章节</li><li>完成练习和研读</li></ol><a href={`${base}paths/`}>查看全部路径 →</a></article>
        <article><small>章节学习页</small><h3>需要系统读懂一章</h3><p>每章提供三档预计用时、六步学习地图、学习单元、案例、综合练习和章末复盘。</p><ol><li>选择速览、标准或深研</li><li>沿任务地图留下进度</li><li>导出本章复盘成果</li></ol><a href={`${base}chapters/ch01/#journey`}>体验章节学习地图 →</a></article>
        <article><small>概念词典与图谱</small><h3>概念太多，关系混乱</h3><p>词典用于精确查义，图谱用于理解跨章关系。路径探索会说明两个概念间隔着哪些节点。</p><ol><li>搜索概念</li><li>筛选关系与置信度</li><li>打开词条核对定义</li></ol><a href={`${base}concepts/`}>打开概念词典 →</a></article>
        <article><small>互动实验室</small><h3>“看懂了”但不会判断</h3><p>实验不只做选择题，还包括分类、排序、拼合、模拟、证据研判和综合案卷。</p><ol><li>先独立作答</li><li>阅读诊断反馈</li><li>带着错误返回章节</li></ol><a href={`${base}lab/`}>选择一个实验 →</a></article>
        <article><small>搜索</small><h3>我带着一个具体问题来</h3><p>搜索同时覆盖章节、学习单元、概念和实验入口，适合把网站当作个人知识索引。</p><ol><li>输入术语或问题词</li><li>观察结果所属类型</li><li>进入章节或词条</li></ol><a href={`${base}search/`}>搜索全站内容 →</a></article>
        <article><small>札记与收藏</small><h3>读过之后容易忘记</h3><p>每个页面右下角都有随身札记；个人工作台集中编辑札记、收藏和最近浏览。</p><ol><li>收藏重要页面</li><li>写下疑问与判断</li><li>导出 Markdown 复习</li></ol><a href={`${base}notebook/`}>打开个人工作台 →</a></article>
        <article><small>学习进度与成果册</small><h3>如何知道学过什么、接下来做什么</h3><p>进度页综合练习、研读和案例给出下一步推荐，并把十四章复盘整理成学习证据画像和成果报告；没有记录时可先切换只读示例。</p><ol><li>查看推荐章节与待追问题</li><li>检查十四章成果脊柱</li><li>导出完整成果或备份档案</li></ol><a href={`${base}progress/?welcome=0&portfolio=sample#portfolio`}>先查看示例成果 →</a></article>
      </div></section>

      <section id="records"><p class="eyebrow">03 · Local records</p><h2>学习记录、备份与隐私</h2><div class="record-flow"><span>在浏览器学习与写札记</span><i>→</i><span>仅保存到本机</span><i>→</i><span>工作台与进度页汇总</span><i>→</i><span>导出 JSON 备份</span></div><ul><li>网站不要求注册，不把学习进度、札记、章节复盘或浏览记录上传到服务器。</li><li>最近浏览仅用于在本机提供“继续学习”，最多保留 30 条。</li><li>更换浏览器、设备或清除浏览器数据时，本地记录可能丢失。</li><li>请在进度页使用“备份数据 .json”；换设备后可恢复进度、错题、札记、收藏与章节复盘。</li><li>学习档案不包含账号、设备指纹或站外浏览历史。</li></ul></section>

      <section id="reading"><p class="eyebrow">04 · Reading notes</p><h2>怎样理解网站里的内容状态？</h2><div class="status-guide"><article><b>原创概括</b><p>把原书知识重新组织为学习语言，不等于逐字引文。</p></article><article><b>教学归纳</b><p>为了帮助初学者建立联系而添加的解释，会与原书确认关系区分。</p></article><article><b>待复核</b><p>已经进入结构化系统，但精确页码或学术表述仍待纸本逐条核验。</p></article><article><b>已核验</b><p>已经依据纸本完成核对；仍建议在正式论文中直接引用原书。</p></article></div><p class="guide-warning">这个网站适合学习、复盘与发现问题，不代替原书阅读，也不应作为正式论文中的二手引文来源。</p></section>

      <section id="faq"><p class="eyebrow">05 · FAQ</p><h2>常见问题</h2><details open><summary>为什么我刷新后仍然保留进度？</summary><p>记录保存在浏览器 localStorage 中。它不会上传，但同一浏览器再次访问时仍然存在。</p></details><details><summary>为什么新手引导不再出现？</summary><p>它默认只出现一次。点击本页顶部“重新打开新手引导”即可再次查看。</p></details><details><summary>为什么有些关系标为“教学归纳”？</summary><p>知识图谱区分原书确认、教学归纳和待考关系，避免把为了教学建立的联系伪装成原书原话。</p></details><details><summary>可以在手机上使用吗？</summary><p>可以。章节、练习与进度页均适配手机；知识图谱在桌面端操作空间更充足。</p></details><details><summary>能把原书全文放进来吗？</summary><p>公开网站不会保存或提供原书全文、扫描件或大段转录，主要展示原创概括、评论、元数据和互动案例。</p></details></section>
    </article>
  </div>
</BaseLayout>

<style>
  .guide-hero{padding:7rem 0 4rem;border-bottom:1px solid var(--line);background:linear-gradient(125deg,rgba(169,50,38,.1),transparent 55%)}.guide-hero>div>p:not(.eyebrow){max-width:52rem;color:var(--muted);font-family:var(--serif);font-size:1.08rem;line-height:1.9}.guide-hero>div>div{display:flex;flex-wrap:wrap;gap:.65rem;margin-top:1.4rem}.guide-hero a{padding:.65rem .85rem;border:1px solid var(--cinnabar);color:var(--cinnabar);text-decoration:none}.guide-hero a:first-child{color:#fff9ee;background:var(--cinnabar)}.guide-main{display:grid;grid-template-columns:190px minmax(0,1fr);gap:5rem;padding-block:4rem 7rem}.guide-toc{position:sticky;top:100px;display:flex;height:max-content;flex-direction:column;border-top:1px solid var(--line)}.guide-toc small,.guide-toc a{padding:.55rem 0;color:var(--muted);border-bottom:1px solid var(--line);font-size:.76rem;text-decoration:none}.guide-main article>section{scroll-margin-top:100px;padding:0 0 4rem;margin-bottom:4rem;border-bottom:1px solid var(--line)}.guide-main h2{margin:.2rem 0 1.3rem;font-family:var(--serif);font-size:2.2rem}.quick-steps{display:grid;gap:.55rem}.quick-steps>article{display:grid;grid-template-columns:70px 1fr;gap:1rem;padding:1.1rem;border:1px solid var(--line);background:rgba(255,255,255,.4)}.quick-steps>article>span{color:var(--cinnabar);font-family:var(--serif);font-size:2rem}.quick-steps h3,.feature-manual h3{margin:0;font-family:var(--serif);font-size:1.18rem}.quick-steps p,.feature-manual p,.feature-manual li,.guide-main li,.guide-main details p{color:var(--muted);font-size:.82rem}.quick-steps a,.feature-manual a{color:var(--cinnabar);font-size:.76rem}.feature-manual{display:grid;grid-template-columns:repeat(2,1fr);gap:.7rem}.feature-manual>article{display:flex;min-height:300px;flex-direction:column;padding:1.2rem;border:1px solid var(--line);background:#fffaf0}.feature-manual small{color:var(--cinnabar);letter-spacing:.08em}.feature-manual ol{padding-left:1.2rem}.feature-manual a{margin-top:auto}.record-flow{display:flex;align-items:center;gap:.5rem;flex-wrap:wrap;margin:1.2rem 0}.record-flow span{padding:.55rem .7rem;border:1px solid var(--line);background:#fffaf0;font-size:.76rem}.record-flow i{color:var(--cinnabar);font-style:normal}.status-guide{display:grid;grid-template-columns:repeat(2,1fr);gap:.6rem}.status-guide article{padding:1rem;border-left:3px solid var(--cinnabar);background:#e9dfcf}.status-guide b{font-family:var(--serif)}.status-guide p{margin:.25rem 0;color:var(--muted);font-size:.8rem}.guide-warning{padding:1rem;border:1px solid #c8a497;background:#fffaf0;color:#7b3b32}.guide-main details{padding:.8rem 0;border-bottom:1px solid var(--line)}.guide-main summary{cursor:pointer;font-family:var(--serif);font-size:1.05rem}.guide-main details p{padding-left:1rem}@media(max-width:850px){.guide-main{grid-template-columns:1fr}.guide-toc{display:none}}@media(max-width:600px){.guide-hero{padding:4rem 0 3rem}.feature-manual,.status-guide{grid-template-columns:1fr}.quick-steps>article{grid-template-columns:45px 1fr}}
</style>
